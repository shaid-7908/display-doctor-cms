<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %> - <%= projectName %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .status-badge {
            font-size: 0.85rem;
            padding: 0.4rem 1rem;
            border-radius: 50rem;
            font-weight: 700;
            text-transform: uppercase;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        .status-open { background-color: #e74a3b; color: #fff; }
        .status-pending { background-color: #f6c23e; color: #fff; }
        .status-assigned { background-color: #4e73df; color: #fff; }
        .status-in_progress { background-color: #f6c23e; color: #fff; }
        .status-visit_scheduled { background-color: #36b9cc; color: #fff; }
        .status-resolved { background-color: #1cc88a; color: #fff; }
        .status-paid { background-color: #1cc88a; color: #fff; border: 2px solid #000; }
        .status-waiting_for_parts { background-color: #858796; color: #fff; }
        .status-invoice_generated { background-color: #5a5c69; color: #fff; }
        .status-cancelled { background-color: #eaecf4; color: #5a5c69; }

        .detail-label {
            font-weight: 700;
            color: #4e73df;
            text-transform: uppercase;
            font-size: 0.75rem;
            margin-bottom: 0.25rem;
        }
        .detail-value {
            color: #5a5c69;
            font-size: 1rem;
            margin-bottom: 1.25rem;
        }
        .card-header-custom {
            background-color: #f8f9fc;
            border-bottom: 1px solid #e3e6f0;
            padding: 1rem 1.25rem;
        }
        .issue-desc-box {
            background-color: #f8f9fc;
            padding: 1rem;
            border-radius: 0.35rem;
            border-left: 4px solid #4e73df;
            white-space: pre-wrap;
        }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <%- include('common/topbar') %>
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <% if (!issue) { %>
                        <div class="text-center mt-5">
                            <div class="error mx-auto" data-text="404">404</div>
                            <p class="lead text-gray-800 mb-5">Issue Not Found</p>
                            <p class="text-gray-500 mb-0">It looks like you found a glitch in the matrix...</p>
                            <a href="/cms/issues">&larr; Back to Issues</a>
                        </div>
                    <% } else { %>
                        <!-- Page Heading -->
                        <div class="d-sm-flex align-items-center justify-content-between mb-4">
                            <h1 class="h3 mb-0 text-gray-800">
                                Ticket <span class="text-primary">#<%= issue.ticket_number %></span>
                            </h1>
                            <div>
                                <a href="/cms/issues" class="btn btn-sm btn-secondary shadow-sm mr-2">
                                    <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to List
                                </a>
                                <button class="btn btn-sm btn-primary shadow-sm" id="editIssueBtn" data-id="<%= issue._id %>">
                                    <i class="fas fa-edit fa-sm text-white-50"></i> Edit Issue
                                </button>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Left Column: Main Issue Info -->
                            <div class="col-xl-8 col-lg-7">
                                <!-- Status Card -->
                                <div class="card shadow mb-4">
                                    <div class="card-header card-header-custom d-flex flex-row align-items-center justify-content-between">
                                        <h6 class="m-0 font-weight-bold text-primary">Overview</h6>
                                        <span class="status-badge status-<%= issue.status.toLowerCase() %>"><%= issue.status %></span>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="detail-label">Issue Category</div>
                                                <div class="detail-value"><%= issue.category ? issue.category.name : 'N/A' %></div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="detail-label">Created At</div>
                                                <div class="detail-value"><%= new Date(issue.createdAt).toLocaleString() %></div>
                                            </div>
                                        </div>
                                        <div class="detail-label">Description</div>
                                        <div class="issue-desc-box mb-4"><%= issue.issue_description %></div>
                                    </div>
                                </div>

                                <!-- Resolution Info -->
                                <div class="card shadow mb-4">
                                    <div class="card-header card-header-custom">
                                        <h6 class="m-0 font-weight-bold text-primary">Resolution & Notes</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="detail-label">Resolution Notes</div>
                                        <div class="issue-desc-box bg-light" style="border-left-color: #1cc88a;"><%= issue.resolution_notes || 'No resolution notes provided yet.' %></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Customer & Technician Info -->
                            <div class="col-xl-4 col-lg-5">
                                <!-- Invoice Card -->
                                <% if (issue.invoice) { %>
                                    <div class="card shadow mb-4 border-left-success">
                                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                                            <h6 class="m-0 font-weight-bold text-success"><i class="fas fa-file-invoice-dollar mr-2"></i> Invoice Details</h6>
                                            <span class="status-badge status-<%= issue.invoice.status.toLowerCase() %>"><%= issue.invoice.status %></span>
                                        </div>
                                        <div class="card-body">
                                            <div class="detail-label">Invoice Number</div>
                                            <div class="detail-value font-weight-bold text-dark"><%= issue.invoice.invoice_number %></div>
                                            
                                            <div class="detail-label">Total Amount</div>
                                            <div class="detail-value text-primary font-weight-bold h5">₹<%= issue.invoice.total_amount.toFixed(2) %></div>

                                            <div class="detail-label">Created Date</div>
                                            <div class="detail-value"><%= new Date(issue.invoice.createdAt).toLocaleDateString() %></div>

                                            <hr>
                                            <div class="d-flex flex-column">
                                                <a href="/cms/invoice/view/<%= issue.invoice._id %>" target="_blank" class="btn btn-sm btn-outline-primary btn-block text-left mb-2">
                                                    <i class="fas fa-eye mr-2"></i> View E-Invoice
                                                </a>
                                                <a href="/v1/admin/invoice/download/<%= issue.invoice._id %>" class="btn btn-sm btn-outline-success btn-block text-left mb-2">
                                                    <i class="fas fa-file-pdf mr-2"></i> Download PDF
                                                </a>
                                                <% if (issue.invoice.status === 'PENDING') { %>
                                                    <a href="/cms/invoice/edit/<%= issue.invoice._id %>" class="btn btn-sm btn-outline-info btn-block text-left">
                                                        <i class="fas fa-edit mr-2"></i> Edit Invoice
                                                    </a>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <div class="card shadow mb-4 border-left-secondary">
                                        <div class="card-header py-3">
                                            <h6 class="m-0 font-weight-bold text-secondary"><i class="fas fa-file-invoice mr-2"></i> Invoice Details</h6>
                                        </div>
                                        <div class="card-body text-center py-4">
                                            <p class="text-muted small mb-3">No invoice generated yet for this issue ticket.</p>
                                            <a href="/cms/create-invoice?ticketNumber=<%= issue.ticket_number %>" class="btn btn-sm btn-primary btn-block shadow-sm">
                                                <i class="fas fa-plus fa-sm text-white-50 mr-2"></i> Generate Invoice
                                            </a>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Customer Card -->
                                <div class="card shadow mb-4 border-left-info">
                                    <div class="card-header py-3">
                                        <h6 class="m-0 font-weight-bold text-info"><i class="fas fa-user-circle mr-2"></i> Customer Details</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="detail-label">Full Name</div>
                                        <div class="detail-value font-weight-bold"><%= issue.customer_name %></div>
                                        
                                        <div class="detail-label">Phone Number</div>
                                        <div class="detail-value">
                                            <a href="tel:<%= issue.customer_phone %>"><i class="fas fa-phone-alt fa-sm mr-1"></i> <%= issue.customer_phone %></a>
                                        </div>

                                        <div class="detail-label">Email Address</div>
                                        <div class="detail-value">
                                            <% if (issue.customer_email) { %>
                                                <a href="mailto:<%= issue.customer_email %>"><i class="fas fa-envelope fa-sm mr-1"></i> <%= issue.customer_email %></a>
                                            <% } else { %>
                                                <span class="text-muted">Not provided</span>
                                            <% } %>
                                        </div>

                                        <div class="detail-label">Address</div>
                                        <div class="detail-value">
                                            <% if (issue.customer_address) { %>
                                                <i class="fas fa-map-marker-alt fa-sm mr-1 text-muted"></i> <%= issue.customer_address %>
                                                <% if (issue.customer_pincode) { %> &ndash; <strong><%= issue.customer_pincode %></strong><% } %>
                                            <% } else { %>
                                                <span class="text-muted">Not provided</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Assignment Card -->
                                <div class="card shadow mb-4 border-left-warning">
                                    <div class="card-header py-3">
                                        <h6 class="m-0 font-weight-bold text-warning"><i class="fas fa-tools mr-2"></i> Assignment Info</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="detail-label">Assigned Technician</div>
                                        <div class="detail-value">
                                            <% if (issue.technician) { %>
                                                <span class="badge badge-info px-3 my-2 py-2">Name : <%= issue.technician.fullName %></span>
                                                <span class="badge badge-info px-3 my-2 py-2">Phone : <%= issue.technician.phone %></span>
                                                <span class="badge badge-info px-3 my-2 py-2">Email : <%= issue.technician.email %></span>
                                            <% } else { %>
                                                <span class="text-muted">Unassigned</span>
                                            <% } %>
                                        </div>

                                        <div class="detail-label">Scheduled Date</div>
                                        <div class="detail-value text-dark font-weight-bold">
                                            <i class="far fa-calendar-check mr-1"></i> 
                                            <%= issue.scheduled_date ? new Date(issue.scheduled_date).toLocaleDateString() : 'To be scheduled' %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>

                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Display Doctor 2024</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#editIssueBtn').click(function() {
                const id = $(this).data('id');
                // For now, redirect back to issues list and let user find it, 
                // or you could implement the edit modal here as well.
                // Best UX would be to redirect to the issues page with the edit modal open, 
                // but for now let's just alert.
                window.location.href = '/cms/issues'; 
                // Note: The user can edit from the main list.
            });
        });
    </script>

</body>

</html>