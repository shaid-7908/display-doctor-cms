<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %> - <%= projectName %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 50rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .status-open { background-color: #e74a3b; color: #fff; }
        .status-assigned { background-color: #4e73df; color: #fff; }
        .status-in_progress { background-color: #f6c23e; color: #fff; }
        .status-visit_scheduled { background-color: #36b9cc; color: #fff; }
        .status-resolved { background-color: #1cc88a; color: #fff; }
        .status-paid { background-color: #1cc88a; color: #fff; border: 2px solid #000; }
        .status-waiting_for_parts { background-color: #858796; color: #fff; }
        .status-invoice_generated { background-color: #5a5c69; color: #fff; }
        .status-cancelled { background-color: #eaecf4; color: #5a5c69; }
        
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
            <!-- End of Sidebar -->

            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">

                <!-- Main Content -->
                <div id="content">

                    <!-- Topbar -->
                    <%- include('common/topbar') %>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">

                            <!-- Page Heading -->
                            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                <h1 class="h3 mb-0 text-gray-800"><%= pageName %> Management</h1>
                                <button class="btn btn-primary btn-sm shadow-sm" data-toggle="modal" data-target="#issueModal" id="addIssueBtn">
                                    <i class="fas fa-plus fa-sm text-white-50"></i> Create New Issue
                                </button>
                            </div>

                            <!-- Filter Row -->
                            <div class="card shadow mb-4">
                                <div class="card-body">
                                    <form id="filterForm" class="row">
                                        <div class="col-md-4 mb-2">
                                            <div class="input-group">
                                                <input type="text" id="searchInput" class="form-control" placeholder="Search by name, phone or ticket #...">
                                                <div class="input-group-append">
                                                    <button class="btn btn-primary" type="submit">
                                                        <i class="fas fa-search fa-sm"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <select id="statusFilter" class="form-control">
                                                <option value="OPEN">Open</option>
                                                <option value="ASSIGNED">Assigned</option>
                                                <option value="IN_PROGRESS">In Progress</option>
                                                <option value="VISIT_SCHEDULED">Visit Scheduled</option>
                                                <option value="RESOLVED">Resolved</option>
                                                <option value="PAID">Paid</option>
                                                <option value="WAITING_FOR_PARTS">Waiting for Parts</option>
                                                <option value="INVOICE_GENERATED">Invoice Generated</option>
                                                <option value="CANCELLED">Cancelled</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <select id="categoryFilter" class="form-control">
                                                <option value="">All Categories</option>
                                                <% categories.docs.forEach(cat => { %>
                                                    <option value="<%= cat._id %>"><%= cat.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <button type="button" id="resetFilters" class="btn btn-secondary btn-block">Reset</button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Issues Table -->
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Issue List</h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered" id="issueTable" width="100%" cellspacing="0">
                                            <thead>
                                                <tr>
                                                    <th>Ticket #</th>
                                                    <th>Customer</th>
                                                    <th>Phone</th>
                                                    <th>Category</th>
                                                    <th>Status</th>
                                                    <th>Created At</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="issueTableBody">
                                                <!-- Data will be loaded here -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="pagination-container">
                                        <div id="paginationInfo">Showing 0 to 0 of 0 entries</div>
                                        <nav>
                                            <ul class="pagination mb-0" id="paginationList">
                                                <!-- Pagination will be loaded here -->
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.container-fluid -->

                </div>
                <!-- End of Main Content -->

                <!-- Footer -->
                <footer class="sticky-footer bg-white">
                    <div class="container my-auto">
                        <div class="copyright text-center my-auto">
                            <span>Copyright &copy; Display Doctor 2024</span>
                        </div>
                    </div>
                </footer>
                <!-- End of Footer -->

            </div>
            <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Issue Modal -->
    <div class="modal fade" id="issueModal" tabindex="-1" role="dialog" aria-labelledby="issueModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="issueModalLabel">Create New Issue</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form id="issueForm">
                    <input type="hidden" id="issue_id">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="customer_name">Customer Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="customer_name" name="customer_name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="customer_phone">Customer Phone <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="customer_phone" name="customer_phone" required placeholder="e.g. 9876543210">
                                    <small class="form-text text-muted">Enter a valid 10-15 digit phone number.</small>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="category_id">Issue Category <span class="text-danger">*</span></label>
                                    <select class="form-control" id="category_id" name="category_id" required>
                                        <option value="">Select Category</option>
                                        <% categories.docs.forEach(cat => { %>
                                            <option value="<%= cat._id %>"><%= cat.name %></option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="customer_email">Customer Email (Optional)</label>
                                    <input type="email" class="form-control" id="customer_email" name="customer_email">
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="issue_description">Issue Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="issue_description" name="issue_description" rows="3" required></textarea>
                        </div>
                        <div id="editFields" style="display: none;">
                            <hr>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="status">Status</label>
                                        <select class="form-control" id="status" name="status">
                                            <option value="OPEN">Open</option>
                                            <option value="ASSIGNED">Assigned</option>
                                            <option value="IN_PROGRESS">In Progress</option>
                                            <option value="VISIT_SCHEDULED">Visit Scheduled</option>
                                            <option value="RESOLVED">Resolved</option>
                                            <option value="PAID">Paid</option>
                                            <option value="WAITING_FOR_PARTS">Waiting for Parts</option>
                                            <option value="INVOICE_GENERATED">Invoice Generated</option>
                                            <option value="CANCELLED">Cancelled</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="scheduled_date">Scheduled Date</label>
                                        <input type="date" class="form-control" id="scheduled_date" name="scheduled_date">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="resolution_notes">Resolution Notes</label>
                                <textarea class="form-control" id="resolution_notes" name="resolution_notes" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit" id="saveIssueBtn">Save Issue</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function () {
            let currentPage = 1;
            const limit = 10;
            let isEdit = false;

            // Initial Load
            loadIssues();

            // Load Issues Function
            function loadIssues() {
                const search = $('#searchInput').val();
                const status = $('#statusFilter').val();
                //const category_id = $('#categoryFilter').val();

                $('#issueTableBody').html('<tr><td colspan="7" class="text-center">Loading...</td></tr>');

                $.ajax({
                    url: '/v1/admin/issue/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        page: currentPage,
                        limit: limit,
                        search: search,
                        status: status,
                       // category_id: category_id
                    }),
                    success: function (res) {
                        const docs = res.data.docs || [];
                        const meta = res.data.meta;
                        let html = '';

                        if (docs.length > 0) {
                            docs.forEach(issue => {
                                const date = new Date(issue.createdAt).toLocaleDateString();
                                const statusClass = issue.status.toLowerCase();
                                
                                html += `
                                    <tr>
                                        <td><a href="/cms/issue-details/${issue._id}"><strong>${issue.ticket_number}</strong></a></td>
                                        <td>${issue.customer_name}</td>
                                        <td>${issue.customer_phone}</td>
                                        <td>${issue.category ? issue.category.name : '-'}</td>
                                        <td><span class="status-badge status-${statusClass}">${issue.status}</span></td>
                                        <td>${date}</td>
                                        <td>
                                            <button class="btn btn-sm btn-info edit-issue-btn" data-id="${issue._id}" title="Edit"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger delete-issue-btn" data-id="${issue._id}" title="Delete"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="7" class="text-center">No issues found.</td></tr>';
                        }

                        $('#issueTableBody').html(html);
                        renderPagination(meta);
                        updatePaginationInfo(meta);
                    },
                    error: function (err) {
                        console.error(err.responseJSON.message);
                        $('#issueTableBody').html('<tr><td colspan="7" class="text-center text-danger">Error loading data.</td></tr>');
                    }
                });
            }

            // Render Pagination
            function renderPagination(meta) {
                let html = '';
                
                // Previous
                html += `<li class="page-item ${!meta.hasPrevPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page - 1}">Previous</a>
                </li>`;

                // Simplified pagination: just show some pages
                const totalPages = Math.ceil(meta.totalDocs / meta.limit);
                for (let i = 1; i <= totalPages; i++) {
                    if (i === meta.page) {
                        html += `<li class="page-item active"><a class="page-link" href="#">${i}</a></li>`;
                    } else {
                        // Only show first, last, and around current
                        if (i === 1 || i === totalPages || (i >= meta.page - 2 && i <= meta.page + 2)) {
                            html += `<li class="page-item"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
                        } else if (i === meta.page - 3 || i === meta.page + 3) {
                            html += `<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`;
                        }
                    }
                }

                // Next
                html += `<li class="page-item ${!meta.hasNextPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page + 1}">Next</a>
                </li>`;

                $('#paginationList').html(html);
            }

            function updatePaginationInfo(meta) {
                const start = meta.totalDocs === 0 ? 0 : meta.skip + 1;
                const end = Math.min(meta.skip + meta.limit, meta.totalDocs);
                $('#paginationInfo').text(`Showing ${start} to ${end} of ${meta.totalDocs} entries`);
            }

            // Pagination click
            $(document).on('click', '.page-link', function (e) {
                e.preventDefault();
                const page = $(this).data('page');
                if (page && page !== currentPage) {
                    currentPage = page;
                    loadIssues();
                }
            });

            // Filter changes
            $('#filterForm').submit(function (e) {
                e.preventDefault();
                currentPage = 1;
                loadIssues();
            });

            $('#statusFilter, #categoryFilter').change(function() {
                currentPage = 1;
                loadIssues();
            });

            $('#resetFilters').click(function() {
                $('#filterForm')[0].reset();
                currentPage = 1;
                loadIssues();
            });

            // Add Issue
            $('#addIssueBtn').click(function() {
                isEdit = false;
                $('#issueModalLabel').text('Create New Issue');
                $('#issueForm')[0].reset();
                $('#issue_id').val('');
                $('#editFields').hide();
                $('#saveIssueBtn').text('Create Issue');
            });

            // Edit Issue
            $(document).on('click', '.edit-issue-btn', function() {
                const id = $(this).data('id');
                isEdit = true;
                $('#issueModalLabel').text('Edit Issue');
                $('#editFields').show();
                $('#saveIssueBtn').text('Update Issue');

                $.get(`/v1/admin/issue/${id}`, function(res) {
                    const issue = res.data;
                    $('#issue_id').val(issue._id);
                    $('#customer_name').val(issue.customer_name);
                    $('#customer_phone').val(issue.customer_phone);
                    $('#customer_email').val(issue.customer_email || '');
                    $('#category_id').val(issue.category_id);
                    $('#issue_description').val(issue.issue_description);
                    $('#status').val(issue.status);
                    
                    if (issue.scheduled_date) {
                        const date = new Date(issue.scheduled_date).toISOString().split('T')[0];
                        $('#scheduled_date').val(date);
                    } else {
                        $('#scheduled_date').val('');
                    }
                    
                    $('#resolution_notes').val(issue.resolution_notes || '');
                    
                    $('#issueModal').modal('show');
                });
            });

            // Form Submit (Add/Edit)
            $('#issueForm').submit(function(e) {
                e.preventDefault();
                const id = $('#issue_id').val();
                
                const data = {
                    customer_name: $('#customer_name').val(),
                    customer_phone: $('#customer_phone').val(),
                    customer_email: $('#customer_email').val() || undefined,
                    category_id: $('#category_id').val(),
                    issue_description: $('#issue_description').val()
                };

                if (isEdit) {
                    data.status = $('#status').val();
                    data.scheduled_date = $('#scheduled_date').val() || undefined;
                    data.resolution_notes = $('#resolution_notes').val() || undefined;
                }

                const url = isEdit ? `/v1/admin/issue/${id}` : '/v1/admin/issue';
                const method = isEdit ? 'PATCH' : 'POST';

                $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        $('#issueModal').modal('hide');
                        alert(res.message);
                        loadIssues();
                    },
                    error: function(err) {
                        const msg = err.responseJSON ? (Array.isArray(err.responseJSON.message) ? err.responseJSON.message.join(', ') : err.responseJSON.message) : 'Operation failed';
                        alert(msg);
                    }
                });
            });

            // Delete Issue
            $(document).on('click', '.delete-issue-btn', function() {
                if (confirm('Are you sure you want to delete this issue?')) {
                    const id = $(this).data('id');
                    $.ajax({
                        url: `/v1/admin/issue/${id}`,
                        type: 'DELETE',
                        success: function(res) {
                            alert(res.message);
                            loadIssues();
                        },
                        error: function(err) {
                            alert('Delete failed');
                        }
                    });
                }
            });
        });
    </script>

</body>

</html>