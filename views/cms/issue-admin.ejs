<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %> - <%= projectName %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 50rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .status-open { background-color: #e74a3b; color: #fff; }
        .status-assigned { background-color: #4e73df; color: #fff; }
        .status-in_progress { background-color: #f6c23e; color: #fff; }
        .status-visit_scheduled { background-color: #36b9cc; color: #fff; }
        .status-resolved { background-color: #1cc88a; color: #fff; }
        .status-paid { background-color: #1cc88a; color: #fff; border: 2px solid #000; }
        .status-waiting_for_parts { background-color: #858796; color: #fff; }
        .status-invoice_generated { background-color: #5a5c69; color: #fff; }
        .status-cancelled { background-color: #eaecf4; color: #5a5c69; }
        
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
            <!-- End of Sidebar -->

            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">

                <!-- Main Content -->
                <div id="content">

                    <!-- Topbar -->
                    <%- include('common/topbar') %>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">

                            <!-- Page Heading -->
                            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                <h1 class="h3 mb-0 text-gray-800"><%= pageName %> Management</h1>
                                <button class="btn btn-primary btn-sm shadow-sm" data-toggle="modal" data-target="#issueModal" id="addIssueBtn">
                                    <i class="fas fa-plus fa-sm text-white-50"></i> Create New Issue
                                </button>
                            </div>

                            <!-- Filter Row -->
                            <div class="card shadow mb-4">
                                <div class="card-body">
                                    <form id="filterForm" class="row">
                                        <div class="col-md-4 mb-2">
                                            <div class="input-group">
                                                <input type="text" id="searchInput" class="form-control" placeholder="Search by name, phone or ticket #...">
                                                <div class="input-group-append">
                                                    <button class="btn btn-primary" type="submit">
                                                        <i class="fas fa-search fa-sm"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <select id="statusFilter" class="form-control">
                                                <option value="ALL_STATUS">All Status</option>
                                                <option value="OPEN">Open</option>
                                                <option value="ASSIGNED">Assigned</option>
                                                <option value="IN_PROGRESS">In Progress</option>
                                                <option value="VISIT_SCHEDULED">Visit Scheduled</option>
                                                <option value="RESOLVED">Resolved</option>
                                                <option value="PAID">Paid</option>
                                                <option value="WAITING_FOR_PARTS">Waiting for Parts</option>
                                                <option value="INVOICE_GENERATED">Invoice Generated</option>
                                                <option value="CANCELLED">Cancelled</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 mb-2">
                                            <select id="categoryFilter" class="form-control">
                                                <option value="">All Categories</option>
                                                <% categories.docs.forEach(cat => { %>
                                                    <option value="<%= cat._id %>"><%= cat.name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="col-md-2 mb-2">
                                            <button type="button" id="resetFilters" class="btn btn-secondary btn-block">Reset</button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            <!-- Issues Table -->
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Issue List</h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered" id="issueTable" width="100%" cellspacing="0">
                                            <thead>
                                                <tr>
                                                    <th>Ticket #</th>
                                                    <th>Customer</th>
                                                    <th>Phone</th>
                                                    <th>Category</th>
                                                    <th>Status</th>
                                                    <th>Created At</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody id="issueTableBody">
                                                <!-- Data will be loaded here -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="pagination-container">
                                        <div id="paginationInfo">Showing 0 to 0 of 0 entries</div>
                                        <nav>
                                            <ul class="pagination mb-0" id="paginationList">
                                                <!-- Pagination will be loaded here -->
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.container-fluid -->

                </div>
                <!-- End of Main Content -->

                <!-- Footer -->
                <footer class="sticky-footer bg-white">
                    <div class="container my-auto">
                        <div class="copyright text-center my-auto">
                            <span>Copyright &copy; Display Doctor 2024</span>
                        </div>
                    </div>
                </footer>
                <!-- End of Footer -->

            </div>
            <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Issue Modal -->
    <div class="modal fade" id="issueModal" tabindex="-1" role="dialog" aria-labelledby="issueModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="issueModalLabel">Create New Issue</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="issueForm">
                    <input type="hidden" id="issue_id">
                    <div class="modal-body">

                        <!-- Locked status banner (shown only for INVOICE_GENERATED / PAID) -->
                        <div id="lockedBanner" class="alert alert-warning d-none" role="alert">
                            <i class="fas fa-lock mr-1"></i>
                            This issue is <strong id="lockedStatusLabel"></strong>. Only cancellation is allowed.
                        </div>

                        <!-- Core fields (hidden when locked) -->
                        <div id="coreFields">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="customer_name">Customer Name <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="customer_name" name="customer_name">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="customer_phone">Customer Phone <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="customer_phone" name="customer_phone" placeholder="e.g. 9876543210">
                                        <small class="form-text text-muted">Enter a valid 10-15 digit phone number.</small>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="category_id">Issue Category <span class="text-danger">*</span></label>
                                        <select class="form-control" id="category_id" name="category_id">
                                            <option value="">Select Category</option>
                                            <% categories.docs.forEach(cat => { %>
                                                <option value="<%= cat._id %>"><%= cat.name %></option>
                                            <% }) %>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="customer_email">Customer Email (Optional)</label>
                                        <input type="email" class="form-control" id="customer_email" name="customer_email">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label for="customer_address">Address (Optional)</label>
                                        <input type="text" class="form-control" id="customer_address" name="customer_address" placeholder="Street / Locality">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="customer_pincode">Pincode (Optional)</label>
                                        <input type="text" class="form-control" id="customer_pincode" name="customer_pincode" placeholder="e.g. 400001" maxlength="8">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="issue_description">Issue Description <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="issue_description" name="issue_description" rows="3"></textarea>
                            </div>
                        </div>

                        <!-- Edit-only extended fields -->
                        <div id="editFields" style="display: none;">
                            <hr>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="edit_technician_id">Assign Technician</label>
                                        <select class="form-control" id="edit_technician_id" name="edit_technician_id">
                                            <option value="">-- Unassigned --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="scheduled_date">Scheduled Date</label>
                                        <input type="date" class="form-control" id="scheduled_date" name="scheduled_date">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="status">Status</label>
                                        <select class="form-control" id="status" name="status">
                                            <option value="OPEN">Open</option>
                                            <option value="VISIT_SCHEDULED">Visit Scheduled</option>
                                            <option value="WAITING_FOR_PARTS">Waiting for Parts</option>
                                            <option value="RESOLVED">Resolved</option>
                                            <option value="CANCELLED">Cancelled</option>
                                        </select>
                                        <small class="form-text text-muted">Note: Invoice Generated &amp; Paid statuses are managed by the system.</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="resolution_notes">Resolution Notes</label>
                                        <textarea class="form-control" id="resolution_notes" name="resolution_notes" rows="3"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Locked cancel-only status (INVOICE_GENERATED / PAID) -->
                        <div id="lockedStatusField" style="display: none;">
                            <hr>
                            <div class="form-group">
                                <label for="locked_status">Change Status</label>
                                <select class="form-control" id="locked_status" name="locked_status">
                                    <option value="CANCELLED">Cancel this Issue</option>
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Close</button>
                        <button class="btn btn-primary" type="submit" id="saveIssueBtn">Save Issue</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Assign Technician Modal -->
    <div class="modal fade" id="assignModal" tabindex="-1" role="dialog" aria-labelledby="assignModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="assignModalLabel">Assign Technician</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form id="assignForm">
                    <input type="hidden" id="assign_issue_id">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="technician_id">Select Technician <span class="text-danger">*</span></label>
                            <select class="form-control" id="assign_technician_id" name="technician_id" required>
                                <option value="">Loading technicians...</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="assign_scheduled_date">Scheduled Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="assign_scheduled_date" name="scheduled_date" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit" id="confirmAssignBtn">Assign</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function () {
            let currentPage = 1;
            let globEditIssue;
            const limit = 10;
            let isEdit = false;

            // Initial Load
            loadIssues();

            // Load Issues Function
            function loadIssues() {
                const search = $('#searchInput').val();
                const status = $('#statusFilter').val();
                //const category_id = $('#categoryFilter').val();
                 const localPayload = {
                    page: currentPage,
                     limit: limit,
                     search: search,
                 }
                 if(status !== 'ALL_STATUS'){
                     localPayload.status = status;
                 }
                $('#issueTableBody').html('<tr><td colspan="7" class="text-center">Loading...</td></tr>');

                $.ajax({
                    url: '/v1/admin/issue/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(localPayload) ,                                           
                    success: function (res) {
                        const docs = res.data.docs || [];
                        const meta = res.data.meta;
                        let html = '';

                        if (docs.length > 0) {
                            docs.forEach(issue => {
                                const date = new Date(issue.createdAt).toLocaleDateString();
                                const statusClass = issue.status.toLowerCase();
                                
                                html += `
                                    <tr>
                                        <td><a href="/cms/issue-details/${issue._id}"><strong>${issue.ticket_number}</strong></a></td>
                                        <td>${issue.customer_name}</td>
                                        <td>${issue.customer_phone}</td>
                                        <td>${issue.category ? issue.category.name : '-'}</td>
                                        <td><span class="status-badge status-${statusClass}">${issue.status}</span></td>
                                        <td>${date}</td>
                                        <td>
                                            <button class="btn btn-sm btn-warning assign-issue-btn" data-id="${issue._id}" title="Assign Technician"><i class="fas fa-user-plus"></i></button>
                                            <button class="btn btn-sm btn-info edit-issue-btn" data-id="${issue._id}" title="Edit"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger delete-issue-btn" data-id="${issue._id}" title="Delete"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="7" class="text-center">No issues found.</td></tr>';
                        }

                        $('#issueTableBody').html(html);
                        renderPagination(meta);
                        updatePaginationInfo(meta);
                    },
                    error: function (err) {
                        console.error(err.responseJSON.message);
                        $('#issueTableBody').html('<tr><td colspan="7" class="text-center text-danger">Error loading data.</td></tr>');
                    }
                });
            }

            // Render Pagination
            function renderPagination(meta) {
                let html = '';
                
                // Previous
                html += `<li class="page-item ${!meta.hasPrevPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page - 1}">Previous</a>
                </li>`;

                // Simplified pagination: just show some pages
                const totalPages = Math.ceil(meta.totalDocs / meta.limit);
                for (let i = 1; i <= totalPages; i++) {
                    if (i === meta.page) {
                        html += `<li class="page-item active"><a class="page-link" href="#">${i}</a></li>`;
                    } else {
                        // Only show first, last, and around current
                        if (i === 1 || i === totalPages || (i >= meta.page - 2 && i <= meta.page + 2)) {
                            html += `<li class="page-item"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
                        } else if (i === meta.page - 3 || i === meta.page + 3) {
                            html += `<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`;
                        }
                    }
                }

                // Next
                html += `<li class="page-item ${!meta.hasNextPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page + 1}">Next</a>
                </li>`;

                $('#paginationList').html(html);
            }

            function updatePaginationInfo(meta) {
                const start = meta.totalDocs === 0 ? 0 : meta.skip + 1;
                const end = Math.min(meta.skip + meta.limit, meta.totalDocs);
                $('#paginationInfo').text(`Showing ${start} to ${end} of ${meta.totalDocs} entries`);
            }

            // Pagination click
            $(document).on('click', '.page-link', function (e) {
                e.preventDefault();
                const page = $(this).data('page');
                if (page && page !== currentPage) {
                    currentPage = page;
                    loadIssues();
                }
            });

            // Filter changes
            $('#filterForm').submit(function (e) {
                e.preventDefault();
                currentPage = 1;
                loadIssues();
            });

            $('#statusFilter, #categoryFilter').change(function() {
                currentPage = 1;
                loadIssues();
            });

            $('#resetFilters').click(function() {
                $('#filterForm')[0].reset();
                currentPage = 1;
                loadIssues();
            });

            // Add Issue
            $('#addIssueBtn').click(function() {
                isEdit = false;
                $('#issueModalLabel').text('Create New Issue');
                $('#issueForm')[0].reset();
                $('#issue_id').val('');
                // Show all core fields, hide edit-only sections
                $('#coreFields').show();
                $('#editFields').hide();
                $('#lockedBanner').addClass('d-none');
                $('#lockedStatusField').hide();
                // Make core fields required for create
                $('#customer_name').prop('required', true);
                $('#customer_phone').prop('required', true);
                $('#category_id').prop('required', true);
                $('#issue_description').prop('required', true);
                $('#saveIssueBtn').text('Create Issue').prop('disabled', false);
            });

            // Edit Issue
            $(document).on('click', '.edit-issue-btn', function() {
                const id = $(this).data('id');
                isEdit = true;
                $('#issueModalLabel').text('Edit Issue');
                $('#saveIssueBtn').text('Update Issue').prop('disabled', false);

                const today = new Date().toISOString().split('T')[0];
                $('#scheduled_date').attr('min', today);

                $.get(`/v1/admin/issue/${id}`, function(res) {
                    const issue = res.data;
                    globEditIssue = issue;
                    const lockedStatuses = ['INVOICE_GENERATED', 'PAID'];
                    const isLocked = lockedStatuses.includes(issue.status);

                    $('#issue_id').val(issue._id);

                    if (isLocked) {
                        // --- LOCKED MODE: only allow cancellation ---
                        $('#coreFields').hide();
                        $('#editFields').hide();
                        $('#lockedBanner').removeClass('d-none');
                        $('#lockedStatusLabel').text(issue.status.replace(/_/g, ' '));
                        $('#lockedStatusField').show();
                        // Remove required from core fields so form submits
                        $('#customer_name, #customer_phone, #category_id, #issue_description').prop('required', false);
                    } else {
                        // --- FULL ACCESS MODE ---
                        $('#coreFields').show();
                        $('#editFields').show();
                        $('#lockedBanner').addClass('d-none');
                        $('#lockedStatusField').hide();
                        $('#customer_name, #customer_phone, #category_id, #issue_description').prop('required', true);

                        // Populate core fields
                        $('#customer_name').val(issue.customer_name);
                        $('#customer_phone').val(issue.customer_phone);
                        $('#customer_email').val(issue.customer_email || '');
                        $('#customer_address').val(issue.customer_address || '');
                        $('#customer_pincode').val(issue.customer_pincode || '');
                        $('#category_id').val(issue.category_id);
                        $('#issue_description').val(issue.issue_description);

                        // Populate technician dropdown
                        if (issue.technician_id) {
                            // Pre-select current technician after technicians have loaded
                            const checkAndSet = setInterval(function() {
                                if ($('#edit_technician_id option').length > 1) {
                                    $('#edit_technician_id').val(issue.technician_id);
                                    clearInterval(checkAndSet);
                                }
                            }, 100);
                        } else {
                            $('#edit_technician_id').val('');
                        }

                        // Populate status (no INVOICE_GENERATED / PAID options in dropdown)
                        $('#status').val(issue.status);

                        // Scheduled date
                        if (issue.scheduled_date) {
                            const date = new Date(issue.scheduled_date).toISOString().split('T')[0];
                            $('#scheduled_date').val(date);
                        } else {
                            $('#scheduled_date').val('');
                        }

                        $('#resolution_notes').val(issue.resolution_notes || '');
                    }

                    $('#issueModal').modal('show');
                });
            });

            // Form Submit (Add / Edit)
            $('#issueForm').submit(function(e) {
                e.preventDefault();
                const id = $('#issue_id').val();
                const lockedStatuses = ['INVOICE_GENERATED', 'PAID'];

                let data = {};
                let url, method;

                if (!isEdit) {
                    // CREATE
                    data = {
                        customer_name: $('#customer_name').val(),
                        customer_phone: $('#customer_phone').val(),
                        customer_email: $('#customer_email').val() || undefined,
                        customer_address: $('#customer_address').val() || undefined,
                        customer_pincode: $('#customer_pincode').val() || undefined,
                        category_id: $('#category_id').val(),
                        issue_description: $('#issue_description').val(),
                        status: $('#status').val(),
                        resolution_notes: $('#resolution_notes').val() || undefined
                    };
                    url = '/v1/admin/issue';
                    method = 'POST';
                } else {
                    // Check if we are in locked mode
                    const currentStatusIsLocked = $('#lockedStatusField').is(':visible');

                    if (currentStatusIsLocked) {
                        // Only send status = CANCELLED
                        data = { status: 'CANCELLED' };
                    } else {
                        // Full update
                        data = {
                            customer_name: $('#customer_name').val(),
                            customer_phone: $('#customer_phone').val(),
                            customer_email: $('#customer_email').val() || undefined,
                            customer_address: $('#customer_address').val() || undefined,
                            customer_pincode: $('#customer_pincode').val() || undefined,
                            category_id: $('#category_id').val(),
                            issue_description: $('#issue_description').val(),
                            status: $('#status').val(),
                            resolution_notes: $('#resolution_notes').val() || undefined
                        };

                        // Technician assignment
                        const techId = $('#edit_technician_id').val();
                        if (techId ) {
                            if(globEditIssue.technician_id){
                                techId !== globEditIssue.technician_id.toString()? data.technician_id = techId : null;
                            }else{
                                data.technician_id = techId;
                            }
                        }

                        // Scheduled date
                        const sDate = $('#scheduled_date').val();
                        if (sDate && sDate !== new Date(globEditIssue.scheduled_date).toISOString().split('T')[0]) data.scheduled_date = sDate;
                    }

                    url = `/v1/admin/issue/${id}`;
                    method = 'PATCH';
                }

                $('#saveIssueBtn').prop('disabled', true).text('Saving...');
                console.log(data);
                $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        $('#issueModal').modal('hide');
                        alert(res.message);
                        loadIssues();
                    },
                    error: function(err) {
                        const msg = err.responseJSON
                            ? (Array.isArray(err.responseJSON.message) ? err.responseJSON.message.join(', ') : err.responseJSON.message)
                            : 'Operation failed';
                        alert(msg);
                    },
                    complete: function() {
                        $('#saveIssueBtn').prop('disabled', false).text(isEdit ? 'Update Issue' : 'Create Issue');
                    }
                });
            });

            // Delete Issue
            $(document).on('click', '.delete-issue-btn', function() {
                if (confirm('Are you sure you want to delete this issue?')) {
                    const id = $(this).data('id');
                    $.ajax({
                        url: `/v1/admin/issue/${id}`,
                        type: 'DELETE',
                        success: function(res) {
                            alert(res.message);
                            loadIssues();
                        },
                        error: function(err) {
                            alert('Delete failed');
                        }
                    });
                }
            });

            // --- Assign Technician Logic ---
            let technicians = [];
            
            // Fetch technicians role ID first
            function fetchTechnicians() {
                $.ajax({
                    url: '/v1/admin/role/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 100 }),
                    success: function(res) {
                        const roles = res.data.docs || [];
                        const techRole = roles.find(r => r.role.toLowerCase() === 'technician');
                        if (techRole) {
                            loadTechnicianUsers(techRole._id);
                        }
                    }
                });
            }

            function loadTechnicianUsers(roleId) {
                $.ajax({
                    url: '/v1/admin/user/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 1000, role: roleId, status: 'Active' }),
                    success: function(res) {
                        technicians = res.data.docs || [];
                        let assignHtml = '<option value="">Select Technician</option>';
                        let editHtml = '<option value="">-- Unassigned --</option>';
                        technicians.forEach(t => {
                            assignHtml += `<option value="${t._id}">${t.fullName} (${t.userName})</option>`;
                            editHtml   += `<option value="${t._id}">${t.fullName} (${t.userName})</option>`;
                        });
                        $('#assign_technician_id').html(assignHtml);
                        $('#edit_technician_id').html(editHtml);
                    }
                });
            }

            fetchTechnicians();

            // Open Assign Modal
            $(document).on('click', '.assign-issue-btn', function() {
                const id = $(this).data('id');
                $('#assign_issue_id').val(id);
                $('#assignForm')[0].reset();
                
                // Set min date to today
                const today = new Date().toISOString().split('T')[0];
                $('#assign_scheduled_date').attr('min', today);
                
                $('#assignModal').modal('show');
            });

            // Submit Assignment
            $('#assignForm').submit(function(e) {
                e.preventDefault();
                const id = $('#assign_issue_id').val();
                const data = {
                    technician_id: $('#assign_technician_id').val(),
                    scheduled_date: $('#assign_scheduled_date').val()
                };

                $('#confirmAssignBtn').prop('disabled', true).text('Assigning...');

                $.ajax({
                    url: `/v1/admin/issue/assign-technician/${id}`,
                    type: 'PATCH',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        $('#assignModal').modal('hide');
                        alert(res.message);
                        loadIssues();
                    },
                    error: function(err) {
                        const msg = err.responseJSON ? err.responseJSON.message : 'Assignment failed';
                        alert(Array.isArray(msg) ? msg.join(', ') : msg);
                    },
                    complete: function() {
                        $('#confirmAssignBtn').prop('disabled', false).text('Assign');
                    }
                });
            });
        });
    </script>

</body>

</html>