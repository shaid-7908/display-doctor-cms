<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Warranty Management">
    <meta name="author" content="">

    <title><%= title %> - <%= projectName %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .warranty-active-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 50rem;
            font-weight: 700;
            text-transform: uppercase;
            background-color: #1cc88a;
            color: #fff;
        }

        .warranty-expiring-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 50rem;
            font-weight: 700;
            text-transform: uppercase;
            background-color: #f6c23e;
            color: #fff;
        }
        
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <%- include('common/topbar') %>
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800"><%= pageName %> Management</h1>
                    </div>

                    <!-- Filter Row -->
                    <div class="card shadow mb-4">
                        <div class="card-body">
                            <form id="filterForm" class="row">
                                <div class="col-md-5 mb-2">
                                    <div class="input-group">
                                        <input type="text" id="searchInput" class="form-control" placeholder="Search by invoice number...">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="submit">
                                                <i class="fas fa-search fa-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <select id="technicianFilter" class="form-control">
                                        <option value="ALL_TECHNICIANS">All Technicians</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <button type="button" id="resetFilters" class="btn btn-secondary btn-block">Reset</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Warranties Table -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Active Warranties List</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="warrantyTable" width="100%" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Ticket #</th>
                                            <th>Customer</th>
                                            <th>Customer Phone</th>
                                            <th>Technician</th>
                                            <th>Warranty Duration</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Remaining Days</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="warrantyTableBody">
                                        <!-- Data will be loaded here -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="pagination-container">
                                <div id="paginationInfo">Showing 0 to 0 of 0 entries</div>
                                <nav>
                                    <ul class="pagination mb-0" id="paginationList">
                                        <!-- Pagination will be loaded here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Display Doctor 2024</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function () {
            let currentPage = 1;
            const limit = 10;
            let technicians = [];

            // Load Supporting Data
            fetchTechnicians();

            // Initial Warranties load
            loadWarranties();

            // Fetch technicians logic for filter
            function fetchTechnicians() {
                $.ajax({
                    url: '/v1/admin/role/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 100 }),
                    success: function(res) {
                        const roles = res.data.docs || [];
                        const techRole = roles.find(r => r.role.toLowerCase() === 'technician');
                        if (techRole) {
                            loadTechnicianUsers(techRole._id);
                        }
                    }
                });
            }

            function loadTechnicianUsers(roleId) {
                $.ajax({
                    url: '/v1/admin/user/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 1000, role: roleId, status: 'Active' }),
                    success: function(res) {
                        technicians = res.data.docs || [];
                        let techFilterHtml = '<option value="ALL_TECHNICIANS">All Technicians</option>';
                        technicians.forEach(t => {
                            techFilterHtml += `<option value="${t._id}">${t.fullName} (${t.userName})</option>`;
                        });
                        $('#technicianFilter').html(techFilterHtml);
                    }
                });
            }

            // Fetch and render warranties list
            function loadWarranties() {
                const search = $('#searchInput').val();
                const technician = $('#technicianFilter').val();
                
                const localPayload = {
                    page: currentPage,
                    limit: limit,
                    search: search,
                };
                if (technician && technician !== 'ALL_TECHNICIANS') {
                    localPayload.assigendTo = technician;
                }
                
                $('#warrantyTableBody').html('<tr><td colspan="10" class="text-center">Loading Active Warranties...</td></tr>');

                $.ajax({
                    url: '/v1/admin/warranty/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(localPayload),
                    success: function (res) {
                        const docs = res.docs || [];
                        const meta = res.meta;
                        let html = '';

                        if (docs.length > 0) {
                            docs.forEach(invoice => {
                                const startDate = invoice.warranty_start_date ? new Date(invoice.warranty_start_date).toLocaleDateString() : '-';
                                const endDate = invoice.warranty_end_date ? new Date(invoice.warranty_end_date).toLocaleDateString() : '-';
                                
                                const ticketNumber = invoice.issue ? invoice.issue.ticket_number : '-';
                                const customerName = invoice.issue ? invoice.issue.customer_name : '-';
                                const customerPhone = invoice.issue ? invoice.issue.customer_phone : '-';
                                const technicianName = invoice.technician ? invoice.technician.fullName : 'Unassigned';
                                const warrantyText = invoice.warranty ? `${invoice.warranty} Month(s)` : '-';

                                // Calculate remaining days
                                let remainingDaysText = '-';
                                let badgeClass = 'warranty-active-badge';
                                if (invoice.warranty_end_date) {
                                    const diffTime = new Date(invoice.warranty_end_date).getTime() - new Date().getTime();
                                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                                    if (diffDays > 0) {
                                        remainingDaysText = `${diffDays} Day(s) Left`;
                                        if (diffDays <= 15) {
                                            badgeClass = 'warranty-expiring-badge';
                                        }
                                    } else {
                                        remainingDaysText = 'Expired';
                                        badgeClass = 'badge badge-danger';
                                    }
                                }

                                html += `
                                    <tr>
                                        <td><strong>${invoice.invoice_number}</strong></td>
                                        <td>${ticketNumber}</td>
                                        <td>${customerName}</td>
                                        <td>${customerPhone}</td>
                                        <td>${technicianName}</td>
                                        <td>${warrantyText}</td>
                                        <td>${startDate}</td>
                                        <td>${endDate}</td>
                                        <td><span class="${badgeClass}">${remainingDaysText}</span></td>
                                        <td>
                                            <a href="/cms/invoice/view/${invoice._id}" class="btn btn-sm btn-primary" title="View Invoice" target="_blank"><i class="fas fa-eye"></i></a>
                                            <a href="/v1/admin/invoice/download/${invoice._id}" class="btn btn-sm btn-success" title="Download PDF"><i class="fas fa-file-pdf"></i></a>
                                        </td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="10" class="text-center">No active warranties found.</td></tr>';
                        }

                        $('#warrantyTableBody').html(html);
                        renderPagination(meta);
                        updatePaginationInfo(meta);
                    },
                    error: function (err) {
                        console.error('Error loading warranties data:', err);
                        $('#warrantyTableBody').html('<tr><td colspan="10" class="text-center text-danger">Error loading data.</td></tr>');
                    }
                });
            }

            // Pagination Rendering
            function renderPagination(meta) {
                if (!meta) return;
                let html = '';
                
                // Previous page
                html += `<li class="page-item ${!meta.hasPrevPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page - 1}">Previous</a>
                </li>`;

                const totalPages = Math.ceil(meta.totalDocs / meta.limit);
                for (let i = 1; i <= totalPages; i++) {
                    if (i === meta.page) {
                        html += `<li class="page-item active"><a class="page-link" href="#">${i}</a></li>`;
                    } else {
                        if (i === 1 || i === totalPages || (i >= meta.page - 2 && i <= meta.page + 2)) {
                            html += `<li class="page-item"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
                        } else if (i === meta.page - 3 || i === meta.page + 3) {
                            html += `<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`;
                        }
                    }
                }

                // Next page
                html += `<li class="page-item ${!meta.hasNextPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page + 1}">Next</a>
                </li>`;

                $('#paginationList').html(html);
            }

            function updatePaginationInfo(meta) {
                if (!meta) return;
                const start = meta.totalDocs === 0 ? 0 : meta.skip + 1;
                const end = Math.min(meta.skip + meta.limit, meta.totalDocs);
                $('#paginationInfo').text(`Showing ${start} to ${end} of ${meta.totalDocs} entries`);
            }

            // Handle Pagination Click
            $(document).on('click', '.page-link', function (e) {
                e.preventDefault();
                const page = $(this).data('page');
                if (page && page !== currentPage) {
                    currentPage = page;
                    loadWarranties();
                }
            });

            // Filters submission
            $('#filterForm').submit(function (e) {
                e.preventDefault();
                currentPage = 1;
                loadWarranties();
            });

            $('#technicianFilter').change(function() {
                currentPage = 1;
                loadWarranties();
            });

            $('#resetFilters').click(function() {
                $('#filterForm')[0].reset();
                currentPage = 1;
                loadWarranties();
            });
        });
    </script>

</body>

</html>
