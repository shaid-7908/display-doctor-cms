<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %> - <%= projectName %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            border-radius: 50rem;
            font-weight: 700;
            text-transform: uppercase;
        }
        .status-pending { background-color: #f6c23e; color: #fff; }
        .status-paid { background-color: #1cc88a; color: #fff; }
        .status-cancelled { background-color: #e74a3b; color: #fff; }
        
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1rem;
        }
        .invoice-item-row {
            background-color: #f8f9fc;
            border: 1px solid #eaecf4;
            border-radius: 0.35rem;
            padding: 0.75rem;
            margin-bottom: 0.75rem;
        }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <%- include('common/topbar') %>
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800"><%= pageName %> Management</h1>
                        <button class="btn btn-primary btn-sm shadow-sm" data-toggle="modal" data-target="#invoiceModal" id="addInvoiceBtn">
                            <i class="fas fa-plus fa-sm text-white-50"></i> Create New Invoice
                        </button>
                    </div>

                    <!-- Filter Row -->
                    <div class="card shadow mb-4">
                        <div class="card-body">
                            <form id="filterForm" class="row">
                                <div class="col-md-5 mb-2">
                                    <div class="input-group">
                                        <input type="text" id="searchInput" class="form-control" placeholder="Search by invoice number...">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="submit">
                                                <i class="fas fa-search fa-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <select id="statusFilter" class="form-control">
                                        <option value="ALL_STATUS">All Status</option>
                                        <option value="PENDING">Pending</option>
                                        <option value="PAID">Paid</option>
                                        <option value="CANCELLED">Cancelled</option>
                                    </select>
                                </div>
                                <div class="col-md-3 mb-2">
                                    <button type="button" id="resetFilters" class="btn btn-secondary btn-block">Reset</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Invoices Table -->
                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Invoice List</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="invoiceTable" width="100%" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Ticket #</th>
                                            <th>Customer</th>
                                            <th>Customer Phone</th>
                                            <th>Total Amount</th>
                                            <th>Status</th>
                                            <th>Created At</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="invoiceTableBody">
                                        <!-- Data will be loaded here -->
                                    </tbody>
                                </table>
                            </div>
                            <div class="pagination-container">
                                <div id="paginationInfo">Showing 0 to 0 of 0 entries</div>
                                <nav>
                                    <ul class="pagination mb-0" id="paginationList">
                                        <!-- Pagination will be loaded here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Display Doctor 2024</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Invoice Modal (Create/Edit) -->
    <div class="modal fade" id="invoiceModal" tabindex="-1" role="dialog" aria-labelledby="invoiceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="invoiceModalLabel">Create New Invoice</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="invoiceForm">
                    <input type="hidden" id="invoice_id">
                    <div class="modal-body">

                        <!-- Locked status banner (shown only for PAID or CANCELLED invoices) -->
                        <div id="lockedBanner" class="alert alert-warning d-none" role="alert">
                            <i class="fas fa-lock mr-1"></i>
                            This invoice is <strong id="lockedStatusLabel"></strong>. Further modifications are restricted.
                        </div>

                        <!-- Core fields container -->
                        <div id="invoiceCoreContainer">
                            <!-- Issue Selection -->
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label for="issue_id">Select Issue Ticket <span class="text-danger">*</span></label>
                                        <select class="form-control" id="issue_id" name="issue_id" required>
                                            <option value="">Loading issues...</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- Dynamic Items List -->
                            <div class="card mb-3">
                                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                    <h6 class="m-0 font-weight-bold text-dark">Invoice Items</h6>
                                    <button type="button" class="btn btn-sm btn-primary" id="addItemBtn">
                                        <i class="fas fa-plus fa-sm"></i> Add Item
                                    </button>
                                </div>
                                <div class="card-body" style="max-height: 250px; overflow-y: auto;">
                                    <div id="itemsListContainer">
                                        <!-- Dynamic item rows will be loaded here -->
                                    </div>
                                </div>
                            </div>

                            <!-- Financial inputs -->
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="sub_total">Sub Total ($)</label>
                                        <input type="number" class="form-control" id="sub_total" name="sub_total" value="0.00" readonly>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="service_charges">Service Charges ($)</label>
                                        <input type="number" class="form-control" id="service_charges" name="service_charges" value="0" min="0" step="0.01">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="tax">Tax ($)</label>
                                        <input type="number" class="form-control" id="tax" name="tax" value="0" min="0" step="0.01">
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="discount_amount">Discount ($)</label>
                                        <input type="number" class="form-control" id="discount_amount" name="discount_amount" value="0" min="0" step="0.01">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Status & Total section -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="status">Invoice Status</label>
                                    <select class="form-control" id="status" name="status">
                                        <option value="PENDING">Pending</option>
                                        <option value="PAID">Paid</option>
                                        <option value="CANCELLED">Cancelled</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="total_amount">Total Amount ($)</label>
                                    <input type="number" class="form-control font-weight-bold text-primary" id="total_amount" name="total_amount" value="0.00" readonly>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Close</button>
                        <button class="btn btn-primary" type="submit" id="saveInvoiceBtn">Save Invoice</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function () {
            let currentPage = 1;
            const limit = 10;
            let isEdit = false;
            let globEditInvoice = null;
            let partsList = [];
            let issuesList = [];

            // Load Supporting Data
            loadParts();
            loadIssues();

            // Initial Invoices load
            loadInvoices();

            // Fetch parts list globally for dynamic selection
            function loadParts() {
                $.ajax({
                    url: '/v1/admin/parts/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 1000 }),
                    success: function (res) {
                        partsList = res.data.docs || [];
                    },
                    error: function (err) {
                        console.error('Error loading parts:', err);
                    }
                });
            }

            // Fetch issues list globally for dropdown
            function loadIssues() {
                $.ajax({
                    url: '/v1/admin/issue/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 1000 }),
                    success: function (res) {
                        issuesList = res.data.docs || [];
                        let html = '<option value="">Select Issue Ticket / Customer</option>';
                        issuesList.forEach(issue => {
                            html += `<option value="${issue._id}">Ticket #${issue.ticket_number} - ${issue.customer_name} (${issue.customer_phone})</option>`;
                        });
                        $('#issue_id').html(html);
                    },
                    error: function (err) {
                        console.error('Error loading issues:', err);
                    }
                });
            }

            // Fetch and render invoices list
            function loadInvoices() {
                const search = $('#searchInput').val();
                const status = $('#statusFilter').val();
                
                const localPayload = {
                    page: currentPage,
                    limit: limit,
                    search: search,
                };
                if (status !== 'ALL_STATUS') {
                    localPayload.status = status;
                }
                
                $('#invoiceTableBody').html('<tr><td colspan="8" class="text-center">Loading Invoices...</td></tr>');

                $.ajax({
                    url: '/v1/admin/invoice/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(localPayload),
                    success: function (res) {
                        const docs = res.docs || [];
                        const meta = res.meta;
                        let html = '';

                        if (docs.length > 0) {
                            docs.forEach(invoice => {
                                const date = new Date(invoice.createdAt).toLocaleDateString();
                                const statusClass = invoice.status.toLowerCase();
                                
                                const ticketNumber = invoice.issue ? invoice.issue.ticket_number : '-';
                                const customerName = invoice.issue ? invoice.issue.customer_name : '-';
                                const customerPhone = invoice.issue ? invoice.issue.customer_phone : '-';

                                html += `
                                    <tr>
                                        <td><strong>${invoice.invoice_number}</strong></td>
                                        <td>${ticketNumber}</td>
                                        <td>${customerName}</td>
                                        <td>${customerPhone}</td>
                                        <td class="font-weight-bold">$${invoice.total_amount.toFixed(2)}</td>
                                        <td><span class="status-badge status-${statusClass}">${invoice.status}</span></td>
                                        <td>${date}</td>
                                        <td>
                                            <button class="btn btn-sm btn-info edit-invoice-btn" data-id="${invoice._id}" title="Edit"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger delete-invoice-btn" data-id="${invoice._id}" title="Delete"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="8" class="text-center">No invoices found.</td></tr>';
                        }

                        $('#invoiceTableBody').html(html);
                        renderPagination(meta);
                        updatePaginationInfo(meta);
                    },
                    error: function (err) {
                        console.error('Error loading invoices data:', err);
                        $('#invoiceTableBody').html('<tr><td colspan="8" class="text-center text-danger">Error loading data.</td></tr>');
                    }
                });
            }

            // Pagination Rendering
            function renderPagination(meta) {
                if (!meta) return;
                let html = '';
                
                // Previous page
                html += `<li class="page-item ${!meta.hasPrevPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page - 1}">Previous</a>
                </li>`;

                const totalPages = Math.ceil(meta.totalDocs / meta.limit);
                for (let i = 1; i <= totalPages; i++) {
                    if (i === meta.page) {
                        html += `<li class="page-item active"><a class="page-link" href="#">${i}</a></li>`;
                    } else {
                        if (i === 1 || i === totalPages || (i >= meta.page - 2 && i <= meta.page + 2)) {
                            html += `<li class="page-item"><a class="page-link" href="#" data-page="${i}">${i}</a></li>`;
                        } else if (i === meta.page - 3 || i === meta.page + 3) {
                            html += `<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`;
                        }
                    }
                }

                // Next page
                html += `<li class="page-item ${!meta.hasNextPage ? 'disabled' : ''}">
                    <a class="page-link" href="#" data-page="${meta.page + 1}">Next</a>
                </li>`;

                $('#paginationList').html(html);
            }

            function updatePaginationInfo(meta) {
                if (!meta) return;
                const start = meta.totalDocs === 0 ? 0 : meta.skip + 1;
                const end = Math.min(meta.skip + meta.limit, meta.totalDocs);
                $('#paginationInfo').text(`Showing ${start} to ${end} of ${meta.totalDocs} entries`);
            }

            // Handle Pagination Click
            $(document).on('click', '.page-link', function (e) {
                e.preventDefault();
                const page = $(this).data('page');
                if (page && page !== currentPage) {
                    currentPage = page;
                    loadInvoices();
                }
            });

            // Filters submission
            $('#filterForm').submit(function (e) {
                e.preventDefault();
                currentPage = 1;
                loadInvoices();
            });

            $('#statusFilter').change(function() {
                currentPage = 1;
                loadInvoices();
            });

            $('#resetFilters').click(function() {
                $('#filterForm')[0].reset();
                currentPage = 1;
                loadInvoices();
            });

            // Escape HTML helper
            function escapeHtml(str) {
                if (!str) return '';
                return str
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            // Dynamic items addition
            function addItemRow(partId = '', partName = '', partPrice = 0, partDesc = '', isFormDisabled = false) {
                let partOptions = '<option value="">-- Custom Part --</option>';
                partsList.forEach(p => {
                    const selected = p._id === partId ? 'selected' : '';
                    partOptions += `<option value="${p._id}" ${selected}>${p.part_name} ($${p.part_avg_price})</option>`;
                });

                const disabledAttr = isFormDisabled ? 'disabled' : '';

                const rowHtml = `
                    <div class="row invoice-item-row align-items-end mb-2">
                        <div class="col-md-3">
                            <label class="small font-weight-bold text-muted">Select Part</label>
                            <select class="form-control form-control-sm item-part-select" ${disabledAttr}>
                                ${partOptions}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="small font-weight-bold text-muted">Part Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm item-part-name" value="${escapeHtml(partName)}" required ${disabledAttr}>
                        </div>
                        <div class="col-md-2">
                            <label class="small font-weight-bold text-muted">Price ($) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control form-control-sm item-part-price" value="${partPrice}" min="0" step="0.01" required ${disabledAttr}>
                        </div>
                        <div class="col-md-3">
                            <label class="small font-weight-bold text-muted">Description</label>
                            <input type="text" class="form-control form-control-sm item-part-desc" value="${escapeHtml(partDesc)}" ${disabledAttr}>
                        </div>
                        <div class="col-md-1 text-right">
                            <button type="button" class="btn btn-danger btn-sm remove-item-btn" ${disabledAttr}><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </div>
                `;
                $('#itemsListContainer').append(rowHtml);
            }

            // Add Item button click
            $('#addItemBtn').click(function() {
                addItemRow();
            });

            // Remove Item button click
            $(document).on('click', '.remove-item-btn', function() {
                $(this).closest('.invoice-item-row').remove();
                calculateTotals();
            });

            // Handle Part Dropdown Change
            $(document).on('change', '.item-part-select', function() {
                const val = $(this).val();
                const row = $(this).closest('.invoice-item-row');
                if (val) {
                    const part = partsList.find(p => p._id === val);
                    if (part) {
                        row.find('.item-part-name').val(part.part_name);
                        row.find('.item-part-price').val(part.part_avg_price);
                        row.find('.item-part-desc').val(part.part_description || '');
                    }
                } else {
                    row.find('.item-part-name').val('');
                    row.find('.item-part-price').val(0);
                    row.find('.item-part-desc').val('');
                }
                calculateTotals();
            });

            // Calculate totals dynamically
            function calculateTotals() {
                let subTotal = 0;
                $('.invoice-item-row').each(function() {
                    const price = parseFloat($(this).find('.item-part-price').val()) || 0;
                    subTotal += price;
                });
                $('#sub_total').val(subTotal.toFixed(2));
                
                const serviceCharges = parseFloat($('#service_charges').val()) || 0;
                const tax = parseFloat($('#tax').val()) || 0;
                const discount = parseFloat($('#discount_amount').val()) || 0;
                
                let total = subTotal + serviceCharges + tax - discount;
                if (total < 0) total = 0;
                
                $('#total_amount').val(total.toFixed(2));
            }

            // Recalculate totals on input modification
            $(document).on('input change', '.item-part-price, #service_charges, #tax, #discount_amount', function() {
                calculateTotals();
            });

            // Trigger Add Invoice modal reset
            $('#addInvoiceBtn').click(function() {
                isEdit = false;
                $('#invoiceModalLabel').text('Create New Invoice');
                $('#invoiceForm')[0].reset();
                $('#invoice_id').val('');
                $('#itemsListContainer').empty();
                
                // Form interactions enabled
                $('#issue_id').prop('disabled', false);
                $('#addItemBtn').show();
                $('#saveInvoiceBtn').show();
                $('#status').prop('disabled', false);
                $('#service_charges, #tax, #discount_amount').prop('disabled', false);
                $('#lockedBanner').addClass('d-none');
                
                // Add initial empty item row for ease of entry
                addItemRow();
                calculateTotals();
            });

            // Trigger Edit Invoice modal
            $(document).on('click', '.edit-invoice-btn', function() {
                const id = $(this).data('id');
                isEdit = true;
                $('#invoiceModalLabel').text('Edit Invoice');
                $('#invoiceForm')[0].reset();
                $('#itemsListContainer').empty();

                $.get(`/v1/admin/invoice/${id}`, function(invoice) {
                    globEditInvoice = invoice;
                    $('#invoice_id').val(invoice._id);
                    $('#issue_id').val(invoice.issue_id).prop('disabled', true); // Disallow changing issue associated
                    
                    $('#service_charges').val(invoice.service_charges || 0);
                    $('#tax').val(invoice.tax || 0);
                    $('#discount_amount').val(invoice.discount_amount || 0);
                    $('#status').val(invoice.status);
                    
                    const isLocked = invoice.status === 'PAID' || invoice.status === 'CANCELLED';

                    if (isLocked) {
                        $('#lockedBanner').removeClass('d-none');
                        $('#lockedStatusLabel').text(invoice.status);
                        
                        // Disable fields
                        $('#addItemBtn').hide();
                        $('#saveInvoiceBtn').hide();
                        $('#status').prop('disabled', true);
                        $('#service_charges, #tax, #discount_amount').prop('disabled', true);
                    } else {
                        $('#lockedBanner').addClass('d-none');
                        $('#addItemBtn').show();
                        $('#saveInvoiceBtn').show();
                        $('#status').prop('disabled', false);
                        $('#service_charges, #tax, #discount_amount').prop('disabled', false);
                    }

                    // Load invoice items
                    const items = invoice.items || [];
                    if (items.length > 0) {
                        items.forEach(item => {
                            addItemRow(item.part_id, item.part_name, item.part_avg_price, item.part_description, isLocked);
                        });
                    } else if (!isLocked) {
                        addItemRow();
                    }

                    calculateTotals();
                    $('#invoiceModal').modal('show');
                });
            });

            // Form Submit (Add/Edit)
            $('#invoiceForm').submit(function(e) {
                e.preventDefault();
                const id = $('#invoice_id').val();
                
                const items = [];
                $('.invoice-item-row').each(function() {
                    const part_name = $(this).find('.item-part-name').val();
                    const part_avg_price = parseFloat($(this).find('.item-part-price').val()) || 0;
                    const part_description = $(this).find('.item-part-desc').val() || '';
                    const part_id = $(this).find('.item-part-select').val() || null;
                    
                    if (part_name) {
                        items.push({
                            part_name: part_name,
                            part_avg_price: part_avg_price,
                            part_description: part_description,
                            part_id: part_id || undefined
                        });
                    }
                });

                if (items.length === 0) {
                    alert('Please add at least one item containing a Part Name.');
                    return;
                }

                const sub_total = parseFloat($('#sub_total').val()) || 0;
                const discount_amount = parseFloat($('#discount_amount').val()) || 0;
                const service_charges = parseFloat($('#service_charges').val()) || 0;
                const tax = parseFloat($('#tax').val()) || 0;
                const total_amount = parseFloat($('#total_amount').val()) || 0;
                const status = $('#status').val();

                let data = {};
                let url, method;

                if (!isEdit) {
                    data = {
                        issue_id: $('#issue_id').val(),
                        items: items,
                        sub_total: sub_total,
                        discount_amount: discount_amount,
                        service_charges: service_charges,
                        tax: tax,
                        total_amount: total_amount,
                        status: status
                    };
                    url = '/v1/admin/invoice';
                    method = 'POST';
                } else {
                    data = {
                        items: items,
                        sub_total: sub_total,
                        discount_amount: discount_amount,
                        service_charges: service_charges,
                        tax: tax,
                        total_amount: total_amount,
                        status: status
                    };
                    url = `/v1/admin/invoice/${id}`;
                    method = 'PATCH';
                }

                $('#saveInvoiceBtn').prop('disabled', true).text('Saving...');

                $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        $('#invoiceModal').modal('hide');
                        alert(res.message || 'Invoice saved successfully');
                        loadInvoices();
                    },
                    error: function(err) {
                        console.error(err);
                        const msg = err.responseJSON
                            ? (Array.isArray(err.responseJSON.message) ? err.responseJSON.message.join(', ') : err.responseJSON.message)
                            : 'Operation failed';
                        alert(msg);
                    },
                    complete: function() {
                        $('#saveInvoiceBtn').prop('disabled', false).text('Save Invoice');
                    }
                });
            });

            // Delete Invoice (Soft Delete)
            $(document).on('click', '.delete-invoice-btn', function() {
                if (confirm('Are you sure you want to delete this invoice?')) {
                    const id = $(this).data('id');
                    $.ajax({
                        url: `/v1/admin/invoice/${id}`,
                        type: 'DELETE',
                        success: function(res) {
                            alert(res.message || 'Invoice deleted successfully');
                            loadInvoices();
                        },
                        error: function(err) {
                            console.error(err);
                            alert('Delete failed');
                        }
                    });
                }
            });
        });
    </script>

</body>

</html>
