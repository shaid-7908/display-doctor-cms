<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="/vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
            <!-- End of Sidebar -->

            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">

                <!-- Main Content -->
                <div id="content">

                    <!-- Topbar -->
                    <%- include('common/topbar') %>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">

                            <!-- Page Heading -->
                            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                <h1 class="h3 mb-0 text-gray-800"><%= pageName %></h1>
                                <button class="btn btn-sm btn-primary shadow-sm" data-toggle="modal" data-target="#partModal" id="addPartBtn">
                                    <i class="fas fa-plus fa-sm text-white-50"></i> Add Part
                                </button>
                            </div>

                            <!-- DataTales Example -->
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Parts List</h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered" id="partsTable" width="100%" cellspacing="0">
                                            <thead>
                                                <tr>
                                                    <th>Part Name</th>
                                                    <th>Category</th>
                                                    <th>Avg Price</th>
                                                    <th>Description</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Data will be loaded via AJAX -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.container-fluid -->

                </div>
                <!-- End of Main Content -->

                <!-- Footer -->
                <footer class="sticky-footer bg-white">
                    <div class="container my-auto">
                        <div class="copyright text-center my-auto">
                            <span>Copyright &copy; Display Doctor 2024</span>
                        </div>
                    </div>
                </footer>
                <!-- End of Footer -->

            </div>
            <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Part Modal (Add/Edit) -->
    <div class="modal fade" id="partModal" tabindex="-1" role="dialog" aria-labelledby="partModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="partModalLabel">Add Part</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form id="partForm">
                    <input type="hidden" id="part_id">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="part_name">Part Name</label>
                            <input type="text" class="form-control" id="part_name" name="part_name" required>
                        </div>
                        <div class="form-group">
                            <label for="category_id">Category</label>
                            <select class="form-control" id="category_id" name="category_id" required>
                                <option value="">Select Category</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="part_avg_price">Average Price</label>
                            <input type="number" class="form-control" id="part_avg_price" name="part_avg_price" step="0.01" value="0">
                        </div>
                        <div class="form-group">
                            <label for="part_description">Description</label>
                            <textarea class="form-control" id="part_description" name="part_description" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit" id="savePartBtn">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <!-- Page level plugins -->
    <script src="/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/vendor/datatables/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function() {
            let isEdit = false;
            let partsTable;

            // Load Categories for Dropdown
            function loadCategories() {
                $.ajax({
                    url: '/v1/admin/issue-category/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 1000 }), // Fetch many for dropdown
                    success: function(res) {
                        const categories = res.data.docs || [];
                        let html = '<option value="">Select Category</option>';
                        categories.forEach(cat => {
                            html += `<option value="${cat._id}">${cat.name}</option>`;
                        });
                        $('#category_id').html(html);
                    },
                    error: function(err) {
                        console.error('Error loading categories:', err);
                    }
                });
            }

            loadCategories();

            // Initialize DataTable
            partsTable = $('#partsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '/v1/admin/parts/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: function(d) {
                        return JSON.stringify({
                            page: (d.start / d.length) + 1,
                            limit: d.length,
                            search: d.search.value,
                            sortField: d.columns[d.order[0].column].data,
                            sortOrder: d.order[0].dir
                        });
                    },
                    dataSrc: function(json) {
                        json.recordsTotal = json.data.meta.totalDocs;
                        json.recordsFiltered = json.data.meta.totalDocs;
                        return json.data.docs;
                    }
                },
                columns: [
                    { data: 'part_name' },
                    { 
                        data: 'category',
                        render: function(data, type, row) {
                            return row.category ? row.category.name : '-';
                        }
                    },
                    { data: 'part_avg_price' },
                    { data: 'part_description' },
                    {
                        data: null,
                        orderable: false,
                        render: function(data, type, row) {
                            return `
                                <button class="btn btn-sm btn-info edit-btn" data-id="${row._id}"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-sm btn-danger delete-btn" data-id="${row._id}"><i class="fas fa-trash"></i></button>
                            `;
                        }
                    }
                ]
            });

            // Add Part Button
            $('#addPartBtn').click(function() {
                isEdit = false;
                $('#part_id').val('');
                $('#partForm')[0].reset();
                $('#partModalLabel').text('Add Part');
            });

            // Edit Part Button
            $(document).on('click', '.edit-btn', function() {
                const id = $(this).data('id');
                isEdit = true;
                $.get(`/v1/admin/parts/${id}`, function(res) {
                    const part = res.data;
                    $('#part_id').val(part._id);
                    $('#part_name').val(part.part_name);
                    $('#category_id').val(part.category_id?._id || part.category_id || '');
                    $('#part_avg_price').val(part.part_avg_price);
                    $('#part_description').val(part.part_description);
                    $('#partModalLabel').text('Edit Part');
                    $('#partModal').modal('show');
                });
            });

            // Form Submit
            $('#partForm').submit(function(e) {
                e.preventDefault();
                const id = $('#part_id').val();
                const data = {
                    part_name: $('#part_name').val(),
                    category_id: $('#category_id').val(),
                    part_avg_price: parseFloat($('#part_avg_price').val()) || 0,
                    part_description: $('#part_description').val()
                };

                const url = isEdit ? `/v1/admin/parts/${id}` : '/v1/admin/parts';
                const method = isEdit ? 'PATCH' : 'POST';

                $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        $('#partModal').modal('hide');
                        partsTable.ajax.reload();
                        alert(res.message || 'Saved successfully');
                    },
                    error: function(err) {
                        alert(err.responseJSON?.message || 'Something went wrong');
                    }
                });
            });

            // Delete Part
            $(document).on('click', '.delete-btn', function() {
                if (confirm('Are you sure you want to delete this part?')) {
                    const id = $(this).data('id');
                    $.ajax({
                        url: `/v1/admin/parts/${id}`,
                        type: 'DELETE',
                        success: function(res) {
                            partsTable.ajax.reload();
                            alert(res.message || 'Deleted successfully');
                        },
                        error: function(err) {
                            alert('Delete failed');
                        }
                    });
                }
            });
        });
    </script>

</body>

</html>