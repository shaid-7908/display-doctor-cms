<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">
    
    <style>
        .problem-badge {
            display: inline-block;
            margin: 2px;
            padding: 5px 10px;
            background-color: #f8f9fc;
            border: 1px solid #e3e6f0;
            border-radius: 4px;
            font-size: 0.85rem;
        }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
            <!-- End of Sidebar -->

            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">

                <!-- Main Content -->
                <div id="content">

                    <!-- Topbar -->
                    <%- include('common/topbar') %>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">

                            <!-- Page Heading -->
                            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                <h1 class="h3 mb-0 text-gray-800"><%= pageName %></h1>
                                <button class="btn btn-sm btn-primary shadow-sm" data-toggle="modal" data-target="#categoryModal" id="addCategoryBtn">
                                    <i class="fas fa-plus fa-sm text-white-50"></i> Add Category
                                </button>
                            </div>

                            <!-- Content Row -->
                            <div class="row">
                                <div class="col-12">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="m-0 font-weight-bold text-primary">Issue Categories</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table class="table table-bordered" id="categoryTable" width="100%" cellspacing="0">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Description</th>
                                                            <th>Problems</th>
                                                            <th>Status</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="categoryTableBody">
                                                        <tr>
                                                            <td colspan="5" class="text-center">Loading...</td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.container-fluid -->

                </div>
                <!-- End of Main Content -->

                <!-- Footer -->
                <footer class="sticky-footer bg-white">
                    <div class="container my-auto">
                        <div class="copyright text-center my-auto">
                            <span>Copyright &copy; Display Doctor 2024</span>
                        </div>
                    </div>
                </footer>
                <!-- End of Footer -->

            </div>
            <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Category Modal (Add/Edit) -->
    <div class="modal fade" id="categoryModal" tabindex="-1" role="dialog" aria-labelledby="categoryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="categoryModalLabel">Add Category</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form id="categoryForm">
                    <input type="hidden" id="category_id">
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="name">Category Name</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="2"></textarea>
                        </div>
                        <hr>
                        <h6>Problems</h6>
                        <div id="problemContainer">
                            <!-- Problems will be added here -->
                        </div>
                        <button type="button" class="btn btn-sm btn-info mt-2" id="addProblemRow">
                            <i class="fas fa-plus"></i> Add Problem
                        </button>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit" id="saveCategoryBtn">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function() {
            let isEdit = false;

            loadCategories();

            // Load Categories
            function loadCategories() {
                $.ajax({
                    url: '/v1/admin/issue-category/getall',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ page: 1, limit: 100 }),
                    success: function(res) {
                        const docs = res.data.docs || [];
                        let html = '';
                        if (docs.length > 0) {
                            docs.forEach(cat => {
                                const problems = cat.problem ? cat.problem.map(p => `<span class="problem-badge">${p.name}</span>`).join('') : '';
                                const statusBadge = cat.status === 'Active' ? 'success' : 'secondary';
                                
                                html += `
                                    <tr>
                                        <td>${cat.name}</td>
                                        <td>${cat.description || '-'}</td>
                                        <td>${problems}</td>
                                        <td>
                                            <div class="custom-control custom-switch">
                                                <input type="checkbox" class="custom-control-input status-toggle" id="status_${cat._id}" ${cat.status === 'Active' ? 'checked' : ''} data-id="${cat._id}">
                                                <label class="custom-control-label" for="status_${cat._id}">${cat.status}</label>
                                            </div>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-info edit-btn" data-id="${cat._id}"><i class="fas fa-edit"></i></button>
                                            <button class="btn btn-sm btn-danger delete-btn" data-id="${cat._id}"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                `;
                            });
                        } else {
                            html = '<tr><td colspan="5" class="text-center">No categories found</td></tr>';
                        }
                        $('#categoryTableBody').html(html);
                    },
                    error: function(err) {
                        console.error(err);
                        $('#categoryTableBody').html('<tr><td colspan="5" class="text-center text-danger">Error loading data</td></tr>');
                    }
                });
            }

            // Add Problem Row
            $('#addProblemRow').click(function() {
                addProblemRow();
            });

            function addProblemRow(name = '', desc = '') {
                const row = `
                    <div class="row problem-row mb-2">
                        <div class="col-5">
                            <input type="text" class="form-control form-control-sm prob-name" placeholder="Problem Name" value="${name}" required>
                        </div>
                        <div class="col-5">
                            <input type="text" class="form-control form-control-sm prob-desc" placeholder="Description" value="${desc}">
                        </div>
                        <div class="col-2">
                            <button type="button" class="btn btn-sm btn-danger remove-prob"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                `;
                $('#problemContainer').append(row);
            }

            // Remove Problem Row
            $(document).on('click', '.remove-prob', function() {
                $(this).closest('.problem-row').remove();
            });

            // Reset Modal on Open for Add
            $('#addCategoryBtn').click(function() {
                isEdit = false;
                $('#category_id').val('');
                $('#categoryForm')[0].reset();
                $('#problemContainer').empty();
                $('#categoryModalLabel').text('Add Category');
                addProblemRow(); // Add one empty row by default
            });

            // Edit Button Click
            $(document).on('click', '.edit-btn', function() {
                const id = $(this).data('id');
                isEdit = true;
                $.get(`/v1/admin/issue-category/${id}`, function(res) {
                    const cat = res.data;
                    $('#category_id').val(cat._id);
                    $('#name').val(cat.name);
                    $('#description').val(cat.description);
                    $('#problemContainer').empty();
                    if (cat.problem && cat.problem.length > 0) {
                        cat.problem.forEach(p => addProblemRow(p.name, p.description));
                    } else {
                        addProblemRow();
                    }
                    $('#categoryModalLabel').text('Edit Category');
                    $('#categoryModal').modal('show');
                });
            });

            // Form Submit
            $('#categoryForm').submit(function(e) {
                e.preventDefault();
                const id = $('#category_id').val();
                
                const problems = [];
                $('.problem-row').each(function() {
                    const name = $(this).find('.prob-name').val();
                    const desc = $(this).find('.prob-desc').val();
                    if (name) {
                        problems.push({ name, description: desc });
                    }
                });

                const data = {
                    name: $('#name').val(),
                    description: $('#description').val(),
                    problem: problems
                };

                const url = isEdit ? `/v1/admin/issue-category/${id}` : '/v1/admin/issue-category';
                const method = isEdit ? 'PATCH' : 'POST';

                $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(res) {
                        $('#categoryModal').modal('hide');
                        loadCategories();
                        alert(res.message);
                    },
                    error: function(err) {
                        alert(err.responseJSON.message || 'Something went wrong');
                    }
                });
            });

            // Status Toggle
            $(document).on('change', '.status-toggle', function() {
                const id = $(this).data('id');
                const status = $(this).is(':checked') ? 'Active' : 'Inactive';
                
                $.ajax({
                    url: `/v1/admin/issue-category/status-change/${id}`,
                    type: 'PATCH',
                    contentType: 'application/json',
                    data: JSON.stringify({ status: status }),
                    success: function(res) {
                        loadCategories();
                    },
                    error: function(err) {
                        alert('Status update failed');
                        loadCategories();
                    }
                });
            });

            // Delete Category
            $(document).on('click', '.delete-btn', function() {
                if (confirm('Are you sure you want to delete this category?')) {
                    const id = $(this).data('id');
                    $.ajax({
                        url: `/v1/admin/issue-category/${id}`,
                        type: 'DELETE',
                        success: function(res) {
                            loadCategories();
                            alert(res.message);
                        },
                        error: function(err) {
                            alert('Delete failed');
                        }
                    });
                }
            });
        });
    </script>

</body>

</html>