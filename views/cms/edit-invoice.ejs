<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %> - <%= projectName %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">

    <style>
        .part-results-container {
            position: absolute;
            width: 100%;
            z-index: 1000;
            background: white;
            border: 1px solid #d1d3e2;
            border-radius: 0.35rem;
            max-height: 250px;
            overflow-y: auto;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .part-result-item {
            cursor: pointer;
            padding: 0.5rem 0.75rem;
            border-bottom: 1px solid #eaecf4;
            transition: background-color 0.15s ease-in-out;
        }
        .part-result-item:hover {
            background-color: #f8f9fc;
        }
        .part-result-item:last-child {
            border-bottom: none;
        }
    </style>

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <%- include('common/topbar') %>
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <!-- Page Heading -->
                    <div class="d-sm-flex align-items-center justify-content-between mb-4">
                        <h1 class="h3 mb-0 text-gray-800"><%= pageName %></h1>
                        <a href="/cms/invoices" class="btn btn-sm btn-secondary shadow-sm">
                            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Invoices
                        </a>
                    </div>

                    <div class="row">
                        <!-- Left Column: Associated Issue Details (Read-only) -->
                        <div class="col-xl-5 col-lg-5 mb-4">
                            <div class="card shadow mb-4 border-left-primary" id="selectedIssueCard">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-ticket-alt mr-1"></i> Associated Issue Details</h6>
                                </div>
                                <div class="card-body">
                                    <input type="hidden" id="selected_issue_id">
                                    <div class="text-center py-4" id="issueLoader">
                                        <div class="spinner-border spinner-border-sm text-primary"></div> Loading ticket details...
                                    </div>
                                    <table class="table table-sm table-borderless d-none" id="issueDetailsTable">
                                        <tbody>
                                            <tr>
                                                <th style="width: 35%" class="text-muted">Ticket #</th>
                                                <td id="lbl_ticket_number" class="font-weight-bold text-primary">-</td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Customer</th>
                                                <td id="lbl_customer_name">-</td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Phone</th>
                                                <td id="lbl_customer_phone">-</td>
                                            </tr>
                                            <tr>
                                                <th class="text-muted">Category</th>
                                                <td id="lbl_category_name">-</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Invoice Details -->
                        <div class="col-xl-7 col-lg-7">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary">Invoice Items & Totals</h6>
                                </div>
                                <div class="card-body">
                                    <!-- Locked status banner (shown only for PAID or CANCELLED invoices) -->
                                    <div id="lockedBanner" class="alert alert-warning d-none" role="alert">
                                        <i class="fas fa-lock mr-1"></i>
                                        This invoice is <strong id="lockedStatusLabel"></strong>. Further modifications are restricted.
                                    </div>
                                    
                                    <!-- Part Search Input -->
                                    <div class="form-group position-relative">
                                        <label for="partSearchInput" class="small font-weight-bold text-muted">Search Parts & Materials</label>
                                        <div class="input-group">
                                            <input type="text" id="partSearchInput" class="form-control" placeholder="Type part name to search...">
                                            <div class="input-group-append">
                                                <button class="btn btn-info" type="button" id="addCustomItemBtn">
                                                    <i class="fas fa-plus fa-sm"></i> Custom Item
                                                </button>
                                            </div>
                                        </div>
                                        <div id="partSearchResults" class="part-results-container d-none">
                                            <!-- Results will load here -->
                                        </div>
                                    </div>

                                    <!-- Items Table -->
                                    <div class="table-responsive mb-4">
                                        <table class="table table-bordered table-sm" id="invoiceItemsTable">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th>Item Name <span class="text-danger">*</span></th>
                                                    <th style="width: 20%">Price ($) <span class="text-danger">*</span></th>
                                                    <th>Description</th>
                                                    <th style="width: 12%" class="text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="invoiceItemsBody">
                                                <tr id="noItemsPlaceholder">
                                                    <td colspan="4" class="text-center text-muted py-4">No items added. Search and click a part, or click "Custom Item".</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Financial Calculations Summary -->
                                    <div class="row mb-4">
                                        <div class="col-md-6 offset-md-6">
                                            <table class="table table-sm table-borderless">
                                                <tbody>
                                                    <tr>
                                                        <th class="text-right align-middle text-muted">Sub Total ($)</th>
                                                        <td><input type="number" class="form-control form-control-sm text-right" id="sub_total" name="sub_total" value="0.00" readonly></td>
                                                    </tr>
                                                    <tr>
                                                        <th class="text-right align-middle text-muted">Service Charges (₹)</th>
                                                        <td><input type="number" class="form-control form-control-sm text-right" id="service_charges" name="service_charges" value="0.00" min="0" step="0.01"></td>
                                                    </tr>
                                                    <tr>
                                                        <th class="text-right align-middle text-muted">Visiting Charges (₹)</th>
                                                        <td><input type="number" class="form-control form-control-sm text-right" id="visiting_charge" name="visiting_charge" value="299.00" min="0" readonly></td>
                                                    </tr>
                                                    <tr>
                                                        <th class="text-right align-middle text-muted">Discount (₹)</th>
                                                        <td><input type="number" class="form-control form-control-sm text-right" id="discount_amount" name="discount_amount" value="0.00" min="0" step="0.01"></td>
                                                    </tr>
                                                    <tr class="border-top">
                                                        <th class="text-right align-middle font-weight-bold text-dark h5">Total Amount ($₹)</th>
                                                        <td><input type="number" class="form-control form-control-sm text-right font-weight-bold text-primary" id="total_amount" name="total_amount" value="0.00" readonly></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Invoice Options and Save -->
                                    <hr>
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <div class="form-group mb-0">
                                                <label for="warranty" class="small font-weight-bold text-muted">Warranty Period</label>
                                                <select class="form-control" id="warranty" name="warranty">
                                                    <option value="0">No Warranty</option>
                                                    <option value="1">1 Month</option>
                                                    <option value="2">2 Months</option>
                                                    <option value="3">3 Months</option>
                                                    <option value="4">4 Months</option>
                                                    <option value="5">5 Months</option>
                                                    <option value="6">6 Months</option>
                                                    <option value="7">7 Months</option>
                                                    <option value="8">8 Months</option>
                                                    <option value="9">9 Months</option>
                                                    <option value="10">10 Months</option>
                                                    <option value="11">11 Months</option>
                                                    <option value="12">12 Months</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-0">
                                                <label for="status" class="small font-weight-bold text-muted">Invoice Status</label>
                                                <select class="form-control" id="status" name="status">
                                                    <option value="PENDING">Pending</option>
                                                    <option value="PAID">Paid</option>
                                                    <option value="CANCELLED">Cancelled</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-12 text-right">
                                            <a href="/cms/invoices" class="btn btn-secondary btn-sm mr-2">Cancel</a>
                                            <button type="button" class="btn btn-primary btn-sm" id="submitInvoiceBtn">
                                                <i class="fas fa-save mr-1"></i> Save Changes
                                            </button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; Display Doctor 2024</span>
                    </div>
                </div>
            </footer>
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        const invoiceId = '<%= invoiceId %>';
        $(document).ready(function () {
            let partSearchTimeout;

            // Fetch invoice details and populate fields
            if (invoiceId) {
                $.get(`/v1/admin/invoice/${invoiceId}`, function (invoice) {
                    console.log(invoice)
                    $('#selected_issue_id').val(invoice._doc.issue_id._id);
                    $('#lbl_ticket_number').text('Ticket #' + invoice._doc.issue_id.ticket_number);
                    $('#lbl_customer_name').text(invoice._doc.issue_id.customer_name);
                    $('#lbl_customer_phone').text(invoice._doc.issue_id.customer_phone);
                    $('#lbl_category_name').text(invoice._doc.issue_id.category_id ? invoice._doc.issue_id.category_id.name : '-');

                    $('#issueLoader').addClass('d-none');
                    $('#issueDetailsTable').removeClass('d-none');

                    // Populate fields
                    $('#service_charges').val(invoice._doc.service_charges || 0);
                    $('#visiting_charge').val(invoice._doc.visiting_charge || 0);
                    $('#discount_amount').val(invoice._doc.discount_amount || 0);
                    $('#warranty').val(invoice._doc.warranty || 0);
                    $('#status').val(invoice._doc.status);

                    // Check if locked (PAID or CANCELLED)
                    const isLocked = invoice._doc.status === 'PAID' || invoice._doc.status === 'CANCELLED';
                    if (isLocked) {
                        $('#lockedBanner').removeClass('d-none');
                        $('#lockedStatusLabel').text(invoice._doc.status);
                        
                        // Disable controls
                        $('#partSearchInput').prop('disabled', true);
                        $('#addCustomItemBtn').hide();
                        $('#submitInvoiceBtn').hide();
                        $('#service_charges, #discount_amount, #warranty, #status').prop('disabled', true);
                    }

                    // Populate items list
                    const items = invoice._doc.items || [];
                    if (items.length > 0) {
                        $('#noItemsPlaceholder').addClass('d-none');
                        items.forEach(item => {
                            addItemRow(item.part_id, item.part_name, item.part_avg_price, item.part_description, isLocked);
                        });
                    }

                    calculateTotals();
                }).fail(function(err) {
                    console.error('Error fetching invoice:', err);
                    alert('Error loading invoice details.');
                    window.location.href = '/cms/invoices';
                });
            }

            // Search Parts Autocomplete
            $('#partSearchInput').on('input', function () {
                clearTimeout(partSearchTimeout);
                const query = $(this).val().trim();
                if (!query) {
                    $('#partSearchResults').addClass('d-none').empty();
                    return;
                }

                partSearchTimeout = setTimeout(function () {
                    $.ajax({
                        url: '/v1/admin/parts/getall',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ page: 1, limit: 15, search: query }),
                        success: function (res) {
                            const docs = res.data.docs || [];
                            if (docs.length === 0) {
                                $('#partSearchResults').removeClass('d-none').html(
                                    '<div class="p-3 text-muted text-center small">No matching parts found. Click "Custom Item" to add manual details.</div>'
                                );
                                return;
                            }

                            let html = '';
                            docs.forEach(part => {
                                html += `
                                    <div class="part-result-item d-flex justify-content-between align-items-center select-part-btn"
                                        data-id="${part._id}"
                                        data-name="${escapeHtml(part.part_name)}"
                                        data-price="${part.part_avg_price}"
                                        data-desc="${escapeHtml(part.part_description || '')}">
                                        <div>
                                            <strong class="text-dark">${part.part_name}</strong>
                                            <div class="small text-muted">${part.part_description || 'No description'}</div>
                                        </div>
                                        <span class="badge badge-primary font-weight-bold">$${part.part_avg_price.toFixed(2)}</span>
                                    </div>
                                `;
                            });
                            $('#partSearchResults').removeClass('d-none').html(html);
                        }
                    });
                }, 300);
            });

            // Close parts autocomplete on outside click
            $(document).click(function (e) {
                if (!$(e.target).closest('.position-relative').length) {
                    $('#partSearchResults').addClass('d-none').empty();
                }
            });

            // Select Part Trigger
            $(document).on('click', '.select-part-btn', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                const price = $(this).data('price');
                const desc = $(this).data('desc');

                addItemRow(id, name, price, desc);

                $('#partSearchInput').val('');
                $('#partSearchResults').addClass('d-none').empty();
            });

            // Add Custom/Manual Item
            $('#addCustomItemBtn').click(function () {
                addItemRow('', '', 0, '');
            });

            // Dynamic items addition
            function addItemRow(partId = '', partName = '', partPrice = 0, partDesc = '', isFormDisabled = false) {
                $('#noItemsPlaceholder').addClass('d-none');

                const cleanPartId = (partId && partId !== 'null') ? partId : '';
                const disabledAttr = isFormDisabled ? 'disabled' : '';

                const rowHtml = `
                    <tr class="invoice-item-row">
                        <td>
                            <input type="hidden" class="item-part-id" value="${cleanPartId}">
                            <input type="text" class="form-control form-control-sm item-part-name" value="${escapeHtml(partName)}" required placeholder="Enter name..." ${disabledAttr}>
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm text-right item-part-price" value="${partPrice}" min="0" step="0.01" required ${disabledAttr}>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm item-part-desc" value="${escapeHtml(partDesc)}" placeholder="Description (optional)" ${disabledAttr}>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-item-btn" ${disabledAttr}>
                                <i class="fas fa-trash-alt fa-xs"></i>
                            </button>
                        </td>
                    </tr>
                `;
                $('#invoiceItemsBody').append(rowHtml);
                calculateTotals();
            }

            // Remove Item Trigger
            $(document).on('click', '.remove-item-btn', function () {
                $(this).closest('.invoice-item-row').remove();
                if ($('.invoice-item-row').length === 0) {
                    $('#noItemsPlaceholder').removeClass('d-none');
                }
                calculateTotals();
            });

            // Recalculate totals on input modification
            $(document).on('input change', '.item-part-price, #service_charges, #tax, #discount_amount', function () {
                calculateTotals();
            });

            // Calculate Totals function
            function calculateTotals() {
                let subTotal = 0;
                $('.invoice-item-row').each(function () {
                    const price = parseFloat($(this).find('.item-part-price').val()) || 0;
                    subTotal += price;
                });
                $('#sub_total').val(subTotal.toFixed(2));

                const serviceCharges = parseFloat($('#service_charges').val()) || 0;
                const visiting_charge = parseFloat($('#visiting_charge').val()) || 0;
                const discount = parseFloat($('#discount_amount').val()) || 0;

                let total = subTotal + serviceCharges + visiting_charge - discount;
                if (total < 0) total = 0;

                $('#total_amount').val(total.toFixed(2));
            }

            // Save and Edit Invoice Submit
            $('#submitInvoiceBtn').click(function () {
                const issueId = $('#selected_issue_id').val();
                if (!issueId) {
                    alert('Error: No associated issue ticket found.');
                    return;
                }

                const items = [];
                $('.invoice-item-row').each(function () {
                    const part_name = $(this).find('.item-part-name').val().trim();
                    const part_avg_price = parseFloat($(this).find('.item-part-price').val()) || 0;
                    const part_description = $(this).find('.item-part-desc').val().trim();
                    let part_id = $(this).find('.item-part-id').val();
                    if (!part_id || part_id === 'null' || part_id.trim() === '') {
                        part_id = undefined;
                    }

                    if (part_name) {
                        items.push({
                            part_name: part_name,
                            part_avg_price: part_avg_price,
                            part_description: part_description,
                            part_id: part_id
                        });
                    }
                });

                if (items.length === 0) {
                    alert('Please add at least one item containing a valid Name.');
                    return;
                }

                const payload = {
                    items: items,
                    sub_total: parseFloat($('#sub_total').val()) || 0,
                    discount_amount: parseFloat($('#discount_amount').val()) || 0,
                    service_charges: parseFloat($('#service_charges').val()) || 0,
                    visiting_charge: parseFloat($('#visiting_charge').val()) || 0,
                    total_amount: parseFloat($('#total_amount').val()) || 0,
                    status: $('#status').val(),
                    warranty: parseInt($('#warranty').val()) || 0
                };

                const $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Saving...');
                console.log(payload)
                $.ajax({
                    url: `/v1/admin/invoice/${invoiceId}`,
                    type: 'PATCH',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        alert(res.message || 'Invoice updated successfully');
                        window.location.href = '/cms/invoices';
                    },
                    error: function (err) {
                        console.error(err);
                        const msg = err.responseJSON
                            ? (Array.isArray(err.responseJSON.message) ? err.responseJSON.message.join(', ') : err.responseJSON.message)
                            : 'Failed to update invoice';
                        alert(msg);
                        $btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Save Changes');
                    }
                });
            });

            // Escape HTML helper
            function escapeHtml(str) {
                if (!str) return '';
                return str
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }
        });
    </script>

</body>

</html>
