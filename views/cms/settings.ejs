<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title><%= title %> - <%= projectName %></title>

    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link
        href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
        rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">

</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('common/sidebar') %>
            <!-- End of Sidebar -->

            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">

                <!-- Main Content -->
                <div id="content">

                    <!-- Topbar -->
                    <%- include('common/topbar') %>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">

                            <!-- Page Heading -->
                            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                                <h1 class="h3 mb-0 text-gray-800"><%= pageName %> Management</h1>
                            </div>

                            <div class="row">
                                <div class="col-lg-8">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3">
                                            <h6 class="m-0 font-weight-bold text-primary">General Configuration</h6>
                                        </div>
                                        <div class="card-body">
                                            <form id="settingsForm" enctype="multipart/form-data">
                                                <div class="form-group row">
                                                    <label class="col-sm-3 col-form-label font-weight-bold">Site Logo</label>
                                                    <div class="col-sm-9">
                                                        <div class="mb-3">
                                                            <img id="logoPreview" src="/img/undraw_profile.svg" alt="Site Logo" style="max-height: 100px; max-width: 250px; border: 1px solid #ddd; padding: 5px; border-radius: 4px; object-fit: contain;">
                                                        </div>
                                                        <div class="custom-file">
                                                            <input type="file" class="custom-file-input" id="siteLogoInput" accept="image/*">
                                                            <label class="custom-file-label" id="siteLogoLabel" for="siteLogoInput">Choose logo image...</label>
                                                        </div>
                                                        <small class="form-text text-muted">Upload a new site logo. The image will be uploaded directly to AWS S3.</small>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="form-group row">
                                                    <label class="col-sm-3 col-form-label font-weight-bold">Invoice Address</label>
                                                    <div class="col-sm-9">
                                                        <textarea class="form-control" id="invoiceAddressInput" rows="4" placeholder="Enter company invoice address..."></textarea>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="form-group row">
                                                    <div class="col-sm-9 offset-sm-3">
                                                        <button type="submit" class="btn btn-primary" id="saveSettingsBtn">
                                                            <span id="saveSpinner" class="spinner-border spinner-border-sm d-none mr-1" role="status"></span>
                                                            Save Settings
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <!-- /.container-fluid -->

                </div>
                <!-- End of Main Content -->

                <!-- Footer -->
                <footer class="sticky-footer bg-white">
                    <div class="container my-auto">
                        <div class="copyright text-center my-auto">
                            <span>Copyright &copy; <%= projectName %> 2026</span>
                        </div>
                    </div>
                </footer>
                <!-- End of Footer -->

            </div>
            <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Bootstrap core JavaScript-->
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- Custom scripts for all pages-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script>
        $(document).ready(function() {
            // Update the filename label on file selection
            $('#siteLogoInput').on('change', function(e) {
                const fileName = e.target.files[0] ? e.target.files[0].name : "Choose logo image...";
                $('#siteLogoLabel').text(fileName);
                
                // Show a local preview of the selected image before saving
                if (e.target.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        $('#logoPreview').attr('src', event.target.result);
                    }
                    reader.readAsDataURL(e.target.files[0]);
                }
            });

            // Load Settings
            function loadSettings() {
                $.ajax({
                    url: '/v1/admin/settings',
                    type: 'GET',
                    success: function(res) {
                        const settings = res.data;
                        if (settings) {
                            $('#invoiceAddressInput').val(settings.invoiceAddress || '');
                            if (settings.siteLogo) {
                                $('#logoPreview').attr('src', settings.siteLogo);
                            }
                        }
                    },
                    error: function(err) {
                        console.error('Error loading settings:', err);
                    }
                });
            }

            loadSettings();

            // Submit Settings
            $('#settingsForm').on('submit', function(e) {
                e.preventDefault();

                const $btn = $('#saveSettingsBtn');
                const $spinner = $('#saveSpinner');

                $btn.prop('disabled', true);
                $spinner.removeClass('d-none');

                const formData = new FormData();
                formData.append('invoiceAddress', $('#invoiceAddressInput').val());
                
                const fileInput = $('#siteLogoInput')[0];
                if (fileInput.files.length > 0) {
                    formData.append('siteLogo', fileInput.files[0]);
                }

                $.ajax({
                    url: '/v1/admin/settings',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        $btn.prop('disabled', false);
                        $spinner.addClass('d-none');
                        alert(res.message || 'Settings saved successfully');
                        loadSettings();
                    },
                    error: function(err) {
                        $btn.prop('disabled', false);
                        $spinner.addClass('d-none');
                        alert(err.responseJSON?.message || 'Failed to save settings');
                    }
                });
            });
        });
    </script>

</body>

</html>
